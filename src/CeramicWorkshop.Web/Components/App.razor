<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CERAMIPRO — logiciel de gestion d'atelier de céramique et de décoration." />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>CERAMIPRO — Gestion d'atelier</title>
    <HeadOutlet @rendermode="ModeInteractif" />
</head>

<body>
    <Routes @rendermode="ModeInteractif" />

    <div id="blazor-error-ui">
        Une erreur est survenue. Cette application ne répond plus tant que la page n'est pas rechargée.
        <a href="." class="reload">Recharger la page</a>
        <span class="dismiss">🗙</span>
    </div>

    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Le pré-rendu est désactivé : la session de l'utilisateur est lue dans le
    // navigateur, ce qui n'est possible qu'une fois la page réellement interactive.
    private static readonly IComponentRenderMode ModeInteractif =
        new InteractiveServerRenderMode(prerender: false);
}
