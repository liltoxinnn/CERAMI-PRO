@page "/utilisateurs"
@attribute [Authorize(Policy = PermissionCodes.UtilisateursConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Utilisateurs — CERAMIPRO</PageTitle>

<div class="page-entete">
    <div>
        <h1>Utilisateurs</h1>
        <p class="page-introduction">Comptes autorisés à utiliser le logiciel de l'atelier.</p>
    </div>

    @if (PeutGerer)
    {
        <button type="button" class="bouton bouton-principal" @onclick="OuvrirCreation">
            + Nouvel utilisateur
        </button>
    }
</div>

<div class="barre-outils">
    <div class="champ-recherche">
        <label for="recherche" class="etiquette-visuellement-cachee">Rechercher un utilisateur</label>
        <input id="recherche" class="saisie" type="search" placeholder="Rechercher un nom, un email, un téléphone…"
               value="@_recherche" @oninput="SurRecherche" />
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des utilisateurs…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <div class="encart-vide">
        <p>Aucun utilisateur ne correspond à votre recherche.</p>
    </div>
}
else
{
    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th scope="col">Nom complet</th>
                <th scope="col">Nom d'utilisateur</th>
                <th scope="col">Rôle</th>
                <th scope="col">État</th>
                <th scope="col">Dernière connexion</th>
                @if (PeutGerer)
                {
                    <th scope="col" class="colonne-actions">Actions</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var utilisateur in _page.Elements)
            {
                <tr>
                    <td data-libelle="Nom complet">@utilisateur.NomComplet</td>
                    <td data-libelle="Nom d'utilisateur">@utilisateur.NomUtilisateur</td>
                    <td data-libelle="Rôle">@utilisateur.RoleNom</td>
                    <td data-libelle="État">
                        <span class="etiquette @(utilisateur.Actif ? "etiquette-succes" : "etiquette-neutre")">
                            @(utilisateur.Actif ? "Actif" : "Désactivé")
                        </span>
                    </td>
                    <td data-libelle="Dernière connexion">
                        @(utilisateur.DerniereConnexion is null
                            ? "Jamais"
                            : MontantFormatter.FormaterDateHeure(utilisateur.DerniereConnexion.Value.ToLocalTime()))
                    </td>
                    @if (PeutGerer)
                    {
                        <td class="colonne-actions" data-libelle="Actions">
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirModification(utilisateur)">Modifier</button>
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirReinitialisation(utilisateur)">Mot de passe</button>
                            @if (utilisateur.Actif)
                            {
                                <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                        @onclick="() => DemanderDesactivation(utilisateur)">Désactiver</button>
                            }
                            else
                            {
                                <button type="button" class="bouton bouton-discret"
                                        @onclick="() => Activer(utilisateur)">Activer</button>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <button type="button" class="bouton bouton-secondaire" disabled="@(!_page.PagePrecedenteDisponible)"
                @onclick="() => ChangerPage(_page.Page - 1)">Précédent</button>
        <span class="pagination-position">
            Page @_page.Page sur @Math.Max(_page.NombrePages, 1) — @_page.Total utilisateur(s)
        </span>
        <button type="button" class="bouton bouton-secondaire" disabled="@(!_page.PageSuivanteDisponible)"
                @onclick="() => ChangerPage(_page.Page + 1)">Suivant</button>
    </div>
}

@if (_formulaireVisible)
{
    <div class="fenetre-fond" @onclick="FermerFormulaire">
        <div class="fenetre fenetre-large" role="dialog" aria-modal="true" aria-labelledby="titre-formulaire"
             @onclick:stopPropagation="true">
            <h2 id="titre-formulaire" class="fenetre-titre">
                @(_modeCreation ? "Nouvel utilisateur" : $"Modifier « {_nomUtilisateurModifie} »")
            </h2>

            <EditForm Model="_formulaire" OnValidSubmit="Enregistrer" class="formulaire">
                <ResumeErreurs Message="@_messageErreur" Details="_details" />

                <div class="grille-formulaire">
                    <div class="champ">
                        <label for="nom-complet">Nom complet</label>
                        <InputText id="nom-complet" class="saisie" @bind-Value="_formulaire.NomComplet" />
                    </div>

                    @if (_modeCreation)
                    {
                        <div class="champ">
                            <label for="identifiant">Nom d'utilisateur</label>
                            <InputText id="identifiant" class="saisie" @bind-Value="_formulaire.NomUtilisateur" />
                            <span class="champ-aide">Lettres, chiffres, point, tiret ou tiret bas.</span>
                        </div>

                        <div class="champ">
                            <label for="mot-de-passe-initial">Mot de passe initial</label>
                            <InputText id="mot-de-passe-initial" type="password" class="saisie"
                                       @bind-Value="_formulaire.MotDePasse" />
                            <span class="champ-aide">Au moins 8 caractères, dont une lettre et un chiffre.</span>
                        </div>
                    }

                    <div class="champ">
                        <label for="email">Adresse email</label>
                        <InputText id="email" class="saisie" @bind-Value="_formulaire.Email" />
                    </div>

                    <div class="champ">
                        <label for="telephone">Téléphone</label>
                        <InputText id="telephone" class="saisie" @bind-Value="_formulaire.Telephone" />
                    </div>

                    <div class="champ">
                        <label for="role">Rôle</label>
                        <InputSelect id="role" class="saisie" @bind-Value="_formulaire.RoleId">
                            <option value="0">— Choisir un rôle —</option>
                            @foreach (var role in _roles)
                            {
                                <option value="@role.Id">@role.Nom</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="champ-case">
                    <InputCheckbox id="actif" @bind-Value="_formulaire.Actif" />
                    <label for="actif">Compte actif</label>
                </div>

                @if (_modeCreation)
                {
                    <div class="champ-case">
                        <InputCheckbox id="changer" @bind-Value="_formulaire.DoitChangerMotDePasse" />
                        <label for="changer">Demander un changement de mot de passe à la première connexion</label>
                    </div>
                }

                <div class="fenetre-actions">
                    <button type="button" class="bouton bouton-secondaire" @onclick="FermerFormulaire">Annuler</button>
                    <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                        @(_enregistrement ? "Enregistrement…" : "Enregistrer")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_reinitialisationVisible)
{
    <div class="fenetre-fond" @onclick="FermerReinitialisation">
        <div class="fenetre" role="dialog" aria-modal="true" aria-labelledby="titre-reinitialisation"
             @onclick:stopPropagation="true">
            <h2 id="titre-reinitialisation" class="fenetre-titre">
                Mot de passe de « @_nomUtilisateurModifie »
            </h2>

            <EditForm Model="_reinitialisation" OnValidSubmit="ReinitialiserMotDePasse" class="formulaire">
                <ResumeErreurs Message="@_messageErreur" Details="_details" />

                <div class="champ">
                    <label for="nouveau-mot-de-passe">Nouveau mot de passe</label>
                    <InputText id="nouveau-mot-de-passe" type="password" class="saisie"
                               @bind-Value="_reinitialisation.NouveauMotDePasse" />
                    <span class="champ-aide">Au moins 8 caractères, dont une lettre et un chiffre.</span>
                </div>

                <div class="champ-case">
                    <InputCheckbox id="forcer" @bind-Value="_reinitialisation.DoitChangerMotDePasse" />
                    <label for="forcer">Demander un changement à la prochaine connexion</label>
                </div>

                <div class="fenetre-actions">
                    <button type="button" class="bouton bouton-secondaire"
                            @onclick="FermerReinitialisation">Annuler</button>
                    <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                        @(_enregistrement ? "Enregistrement…" : "Enregistrer")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<BoiteConfirmation Visible="_confirmationVisible"
                   Titre="Désactiver le compte"
                   Texte="@_texteConfirmation"
                   LibelleConfirmation="Désactiver"
                   Dangereux="true"
                   OnConfirmer="ConfirmerDesactivation"
                   OnAnnuler="() => _confirmationVisible = false" />

@code {
    private PagedResult<UtilisateurDto>? _page;
    private IReadOnlyList<RoleDto> _roles = Array.Empty<RoleDto>();

    private string _recherche = string.Empty;
    private int _pageCourante = 1;
    private bool _chargement = true;

    private bool _formulaireVisible;
    private bool _reinitialisationVisible;
    private bool _confirmationVisible;
    private bool _modeCreation;
    private bool _enregistrement;

    private int _idModifie;
    private string _nomUtilisateurModifie = string.Empty;
    private string _texteConfirmation = string.Empty;

    private FormulaireUtilisateur _formulaire = new();
    private ReinitialiserMotDePasseRequete _reinitialisation = new();

    private string? _messageErreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutGerer => Authentification.Session.PossedeDroit(PermissionCodes.UtilisateursGerer);

    protected override async Task OnInitializedAsync()
    {
        await ChargerRolesAsync();
        await ChargerAsync();
    }

    private async Task ChargerRolesAsync()
    {
        var resultat = await Api.ObtenirAsync<List<RoleDto>>("api/roles");

        if (resultat.Succes && resultat.Valeur is not null)
        {
            _roles = resultat.Valeur;
        }
    }

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/utilisateurs?page={_pageCourante}&taillePage=25";

        if (!string.IsNullOrWhiteSpace(_recherche))
        {
            chemin += $"&recherche={Uri.EscapeDataString(_recherche)}";
        }

        var resultat = await Api.ObtenirAsync<PagedResult<UtilisateurDto>>(chemin);

        if (resultat.Succes)
        {
            _page = resultat.Valeur;
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }

        _chargement = false;
    }

    private async Task SurRecherche(ChangeEventArgs args)
    {
        _recherche = args.Value?.ToString() ?? string.Empty;
        _pageCourante = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _pageCourante = Math.Max(page, 1);
        await ChargerAsync();
    }

    private void OuvrirCreation()
    {
        _modeCreation = true;
        _idModifie = 0;
        _nomUtilisateurModifie = string.Empty;
        _formulaire = new FormulaireUtilisateur { Actif = true, DoitChangerMotDePasse = true };
        ReinitialiserErreurs();
        _formulaireVisible = true;
    }

    private void OuvrirModification(UtilisateurDto utilisateur)
    {
        _modeCreation = false;
        _idModifie = utilisateur.Id;
        _nomUtilisateurModifie = utilisateur.NomUtilisateur;
        _formulaire = new FormulaireUtilisateur
        {
            NomUtilisateur = utilisateur.NomUtilisateur,
            NomComplet = utilisateur.NomComplet,
            Email = utilisateur.Email,
            Telephone = utilisateur.Telephone,
            RoleId = utilisateur.RoleId,
            Actif = utilisateur.Actif
        };
        ReinitialiserErreurs();
        _formulaireVisible = true;
    }

    private void OuvrirReinitialisation(UtilisateurDto utilisateur)
    {
        _idModifie = utilisateur.Id;
        _nomUtilisateurModifie = utilisateur.NomUtilisateur;
        _reinitialisation = new ReinitialiserMotDePasseRequete { DoitChangerMotDePasse = true };
        ReinitialiserErreurs();
        _reinitialisationVisible = true;
    }

    private void FermerFormulaire() => _formulaireVisible = false;

    private void FermerReinitialisation() => _reinitialisationVisible = false;

    private void ReinitialiserErreurs()
    {
        _messageErreur = null;
        _details = Array.Empty<string>();
    }

    private async Task Enregistrer()
    {
        ReinitialiserErreurs();
        _enregistrement = true;

        try
        {
            var resultat = _modeCreation
                ? await Api.PosterAsync<UtilisateurDto>("api/utilisateurs", new CreerUtilisateurRequete
                {
                    NomUtilisateur = _formulaire.NomUtilisateur,
                    NomComplet = _formulaire.NomComplet,
                    Email = _formulaire.Email,
                    Telephone = _formulaire.Telephone,
                    MotDePasse = _formulaire.MotDePasse,
                    RoleId = _formulaire.RoleId,
                    Actif = _formulaire.Actif,
                    DoitChangerMotDePasse = _formulaire.DoitChangerMotDePasse
                })
                : await Api.MettreAJourAsync<UtilisateurDto>($"api/utilisateurs/{_idModifie}",
                    new ModifierUtilisateurRequete
                    {
                        NomComplet = _formulaire.NomComplet,
                        Email = _formulaire.Email,
                        Telephone = _formulaire.Telephone,
                        RoleId = _formulaire.RoleId,
                        Actif = _formulaire.Actif
                    });

            if (!resultat.Succes)
            {
                _messageErreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes(_modeCreation ? "Utilisateur créé." : "Utilisateur modifié.");
            _formulaireVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task ReinitialiserMotDePasse()
    {
        ReinitialiserErreurs();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<object>(
                $"api/utilisateurs/{_idModifie}/mot-de-passe", _reinitialisation);

            if (!resultat.Succes)
            {
                _messageErreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Mot de passe de « {_nomUtilisateurModifie} » réinitialisé.");
            _reinitialisationVisible = false;
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private void DemanderDesactivation(UtilisateurDto utilisateur)
    {
        _idModifie = utilisateur.Id;
        _nomUtilisateurModifie = utilisateur.NomUtilisateur;
        _texteConfirmation =
            $"Le compte « {utilisateur.NomComplet} » ne pourra plus se connecter. Son historique est conservé.";
        _confirmationVisible = true;
    }

    private async Task ConfirmerDesactivation()
    {
        _confirmationVisible = false;

        var resultat = await Api.PosterAsync<object>($"api/utilisateurs/{_idModifie}/desactivation");

        if (resultat.Succes)
        {
            Messages.Succes($"Compte « {_nomUtilisateurModifie} » désactivé.");
            await ChargerAsync();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }

    private async Task Activer(UtilisateurDto utilisateur)
    {
        var resultat = await Api.PosterAsync<object>($"api/utilisateurs/{utilisateur.Id}/activation");

        if (resultat.Succes)
        {
            Messages.Succes($"Compte « {utilisateur.NomUtilisateur} » activé.");
            await ChargerAsync();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }

    /// <summary>Champs communs aux formulaires de création et de modification.</summary>
    private sealed class FormulaireUtilisateur
    {
        public string NomUtilisateur { get; set; } = string.Empty;
        public string NomComplet { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Telephone { get; set; }
        public string MotDePasse { get; set; } = string.Empty;
        public int RoleId { get; set; }
        public bool Actif { get; set; } = true;
        public bool DoitChangerMotDePasse { get; set; } = true;
    }
}
