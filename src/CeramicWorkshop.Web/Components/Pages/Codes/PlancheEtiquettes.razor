@page "/etiquettes/planche"
@layout LayoutImpression
@attribute [Authorize(Policy = PermissionCodes.ProduitsConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Planche d'étiquettes — CERAMIPRO</PageTitle>

<div class="barre-impression">
    <button type="button" class="bouton bouton-principal" @onclick="Imprimer" disabled="@(_etiquettes.Count == 0)">
        Imprimer les étiquettes
    </button>
    <a class="bouton bouton-secondaire" href="etiquettes">Retour au choix des produits</a>
</div>

@if (_chargement)
{
    <Chargement Message="Préparation des étiquettes…" />
}
else if (_etiquettes.Count == 0)
{
    <EtatVide Message="Aucune étiquette à imprimer. Revenez en arrière pour choisir des produits." />
}
else
{
    <div class="planche-etiquettes">
        @foreach (var etiquette in _etiquettes)
        {
            <div class="planche-carte">
                <p class="planche-nom">@etiquette.Nom</p>
                <p class="planche-categorie">@etiquette.Categorie</p>
                <div class="planche-codes">
                    <div class="planche-qr">@((MarkupString)etiquette.CodeQrSvg)</div>
                    <div class="planche-barres">
                        @if (string.IsNullOrWhiteSpace(etiquette.CodeBarresSvg))
                        {
                            <span class="planche-reference">@etiquette.CodeBarres</span>
                        }
                        else
                        {
                            @((MarkupString)etiquette.CodeBarresSvg)
                        }
                    </div>
                </div>
                <p class="planche-prix">@etiquette.PrixAffiche</p>
            </div>
        }
    </div>
}

@code {
    private bool _chargement = true;
    private List<EtiquetteDto> _etiquettes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var adresse = Navigation.ToAbsoluteUri(Navigation.Uri);
            var parametres = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(adresse.Query);

            var produits = parametres.TryGetValue("produits", out var liste)
                ? liste.ToString().Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(valeur => int.TryParse(valeur, out var id) ? id : 0)
                    .Where(id => id > 0)
                    .ToList()
                : new List<int>();

            var exemplaires = parametres.TryGetValue("exemplaires", out var nombre)
                              && int.TryParse(nombre.ToString(), out var valeurNombre)
                ? Math.Clamp(valeurNombre, 1, 50)
                : 1;

            if (produits.Count == 0)
            {
                return;
            }

            var resultat = await Api.PosterAsync<List<EtiquetteDto>>("api/codes/etiquettes",
                new EtiquettesRequete { ProduitIds = produits, Exemplaires = exemplaires });

            if (resultat.Succes && resultat.Valeur is not null)
            {
                _etiquettes = resultat.Valeur;
            }
            else
            {
                Messages.Erreur(resultat.Message);
            }
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task Imprimer() => await Js.InvokeVoidAsync("window.print");
}
