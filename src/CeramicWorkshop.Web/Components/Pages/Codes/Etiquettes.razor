@page "/etiquettes"
@attribute [Authorize(Policy = PermissionCodes.ProduitsConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject NavigationManager Navigation

<PageTitle>Étiquettes — CERAMIPRO</PageTitle>

<EntetePage Titre="Étiquettes des produits"
            Introduction="Imprimez les étiquettes à coller sur les pièces : code QR, code-barres, nom et prix." />

<div class="carte">
    <div class="grille-formulaire">
        <div class="champ">
            <label for="recherche-produit">Produit</label>
            <input id="recherche-produit" class="saisie" placeholder="Nom ou référence du produit"
                   value="@_recherche" autocomplete="off"
                   @oninput="args => _recherche = args.Value?.ToString() ?? string.Empty"
                   @onkeydown="ToucheRecherche" />
        </div>
        <div class="champ">
            <label for="exemplaires">Exemplaires par produit</label>
            <input id="exemplaires" type="number" min="1" max="50" class="saisie" value="@_exemplaires"
                   @onchange="args => _exemplaires = Entier(args)" />
        </div>
    </div>

    <div class="barre-boutons">
        <button type="button" class="bouton bouton-secondaire" @onclick="Rechercher">Rechercher</button>
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des produits…" />
}
else if (_produits.Count == 0)
{
    <EtatVide Message="Aucun produit ne correspond à cette recherche." />
}
else
{
    <div class="carte">
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr><th>À imprimer</th><th>Produit</th><th>Référence</th><th class="nombre">Prix</th></tr>
                </thead>
                <tbody>
                @foreach (var produit in _produits)
                {
                    <tr>
                        <td data-libelle="À imprimer">
                            <input type="checkbox" class="case" checked="@_choisis.Contains(produit.Id)"
                                   aria-label="@($"Étiqueter {produit.Nom}")"
                                   @onchange="args => Choisir(produit.Id, args)" />
                        </td>
                        <td data-libelle="Produit">@produit.Nom</td>
                        <td data-libelle="Référence">@produit.Reference</td>
                        <td class="nombre" data-libelle="Prix">@MontantFormatter.Formater(produit.PrixVente)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="barre-boutons">
            <button type="button" class="bouton bouton-principal" @onclick="Preparer"
                    disabled="@(_choisis.Count == 0)">
                Préparer @(_choisis.Count * _exemplaires) étiquette(s)
            </button>
        </div>
    </div>
}

@code {
    private string _recherche = string.Empty;
    private int _exemplaires = 1;
    private bool _chargement = true;

    private List<ProduitDto> _produits = new();
    private readonly HashSet<int> _choisis = new();

    protected override Task OnInitializedAsync() => Rechercher();

    private static int Entier(ChangeEventArgs args)
        => int.TryParse(args.Value?.ToString(), out var valeur) ? Math.Clamp(valeur, 1, 50) : 1;

    private async Task ToucheRecherche(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await Rechercher();
        }
    }

    private async Task Rechercher()
    {
        _chargement = true;

        try
        {
            var chemin = "api/produits?taillePage=50";

            if (!string.IsNullOrWhiteSpace(_recherche))
            {
                chemin += $"&recherche={Uri.EscapeDataString(_recherche.Trim())}";
            }

            var resultat = await Api.ObtenirAsync<PagedResult<ProduitDto>>(chemin);

            if (resultat.Succes && resultat.Valeur is not null)
            {
                _produits = resultat.Valeur.Elements.ToList();
                _choisis.RemoveWhere(id => _produits.All(p => p.Id != id));
            }
            else
            {
                Messages.Erreur(resultat.Message);
            }
        }
        finally
        {
            _chargement = false;
        }
    }

    private void Choisir(int produitId, ChangeEventArgs args)
    {
        if (args.Value is bool coche && coche)
        {
            _choisis.Add(produitId);
        }
        else
        {
            _choisis.Remove(produitId);
        }
    }

    private void Preparer()
    {
        if (_choisis.Count == 0)
        {
            Messages.Avertissement("Cochez au moins un produit à étiqueter.");
            return;
        }

        var produits = string.Join(',', _choisis);
        Navigation.NavigateTo($"etiquettes/planche?produits={produits}&exemplaires={_exemplaires}");
    }
}
