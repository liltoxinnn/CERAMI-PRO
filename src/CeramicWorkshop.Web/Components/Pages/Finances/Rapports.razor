@page "/rapports"
@attribute [Authorize(Policy = PermissionCodes.RapportsConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification
@inject AdresseServeur Serveur

<PageTitle>Rapports — CERAMIPRO</PageTitle>

<EntetePage Titre="Rapports"
            Introduction="Choisissez un rapport et une période, puis imprimez-le ou exportez-le vers un tableur." />

<div class="filtres">
    <div class="champ">
        <label for="type">Rapport</label>
        <select id="type" class="saisie saisie-compacte" @onchange="ChoisirType">
            @foreach (var (valeur, libelle) in RapportsDisponibles)
            {
                <option value="@valeur" selected="@(valeur == _requete.Type)">@libelle</option>
            }
        </select>
    </div>

    <div class="champ">
        <label for="du">Du</label>
        <input id="du" type="date" class="saisie saisie-compacte" value="@_requete.Du?.ToString("yyyy-MM-dd")"
               @onchange="args => _requete.Du = Date(args)" />
    </div>
    <div class="champ">
        <label for="au">Au</label>
        <input id="au" type="date" class="saisie saisie-compacte" value="@_requete.Au?.ToString("yyyy-MM-dd")"
               @onchange="args => _requete.Au = Date(args)" />
    </div>

    <button type="button" class="bouton bouton-principal" @onclick="Generer" disabled="@_chargement">
        @(_chargement ? "Calcul…" : "Afficher le rapport")
    </button>

    @if (_rapport is not null && PeutExporter)
    {
        <a class="bouton bouton-secondaire" href="@LienExport" target="_blank">Exporter vers Excel</a>
    }

    @if (_rapport is not null)
    {
        <button type="button" class="bouton bouton-secondaire" @onclick="Imprimer">Imprimer</button>
    }
</div>

@if (_chargement)
{
    <Chargement Message="Calcul du rapport…" />
}
else if (_rapport is null)
{
    <EtatVide Message="Choisissez un rapport et une période, puis cliquez sur « Afficher le rapport »." />
}
else
{
    <article class="carte" id="zone-rapport">
        <h2 class="carte-titre">@_rapport.Titre</h2>
        <p class="page-introduction">@_rapport.Periode</p>

        @if (_rapport.Lignes.Count == 0)
        {
            <EtatVide Message="Aucune donnée sur cette période." />
        }
        else
        {
            @if (_rapport.Graphique is not null && _rapport.Graphique.Count > 0)
            {
                <GraphiqueBarres Titre="@_rapport.Titre" Points="_rapport.Graphique"
                                 Monetaire="@EstMonetaire" LibellePeriode="Élément" LibelleValeur="Valeur" />
            }

            <div class="tableau-defilant">
                <table class="tableau">
                    <thead>
                    <tr>
                        @foreach (var colonne in _rapport.Colonnes)
                        {
                            <th>@colonne</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var ligne in _rapport.Lignes)
                    {
                        <tr>
                            @for (var index = 0; index < ligne.Count; index++)
                            {
                                <td data-libelle="@(_rapport.Colonnes.ElementAtOrDefault(index))">@ligne[index]</td>
                            }
                        </tr>
                    }
                    </tbody>
                    @if (_rapport.Totaux is not null)
                    {
                        <tfoot>
                        <tr>
                            @foreach (var total in _rapport.Totaux)
                            {
                                <th>@total</th>
                            }
                        </tr>
                        </tfoot>
                    }
                </table>
            </div>
        }
    </article>
}

@code {
    private RapportDto? _rapport;
    private readonly RapportRequete _requete = new();
    private bool _chargement;

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private bool PeutExporter => Authentification.Session.PossedeDroit(PermissionCodes.RapportsExporter);

    private bool EstMonetaire => _requete.Type is not (TypeRapport.ProduitsEndommages
        or TypeRapport.ProduitsLesPlusVendus);

    private string LienExport
    {
        get
        {
            var lien = $"{Serveur.Base}/api/rapports/export?type={_requete.Type}";
            if (_requete.Du is not null) lien += $"&du={_requete.Du:yyyy-MM-dd}";
            if (_requete.Au is not null) lien += $"&au={_requete.Au:yyyy-MM-dd}";
            return lien;
        }
    }

    private static readonly (TypeRapport Valeur, string Libelle)[] RapportsDisponibles =
    {
        (TypeRapport.ChiffreAffaires, "Chiffre d'affaires"),
        (TypeRapport.Benefices, "Bénéfices"),
        (TypeRapport.Depenses, "Dépenses"),
        (TypeRapport.DettesClients, "Dettes clients"),
        (TypeRapport.DettesFournisseurs, "Dettes fournisseurs"),
        (TypeRapport.ConsommationMatieres, "Consommation des matières"),
        (TypeRapport.Production, "Production"),
        (TypeRapport.ProduitsEndommages, "Produits endommagés"),
        (TypeRapport.ProduitsLesPlusVendus, "Produits les plus vendus"),
        (TypeRapport.ProduitsLesPlusRentables, "Produits les plus rentables"),
        (TypeRapport.ValeurStock, "Valeur du stock"),
        (TypeRapport.PerformanceProduction, "Performance de production")
    };

    protected override void OnInitialized()
    {
        var aujourdhui = DateTime.Today;
        _requete.Du = new DateTime(aujourdhui.Year, aujourdhui.Month, 1);
        _requete.Au = aujourdhui;
    }

    private static DateTime? Date(ChangeEventArgs args)
        => DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;

    private void ChoisirType(ChangeEventArgs args)
    {
        if (Enum.TryParse<TypeRapport>(args.Value?.ToString(), out var type))
        {
            _requete.Type = type;
            _rapport = null;
        }
    }

    private async Task Generer()
    {
        _chargement = true;

        try
        {
            var chemin = $"api/rapports?type={_requete.Type}";
            if (_requete.Du is not null) chemin += $"&du={_requete.Du:yyyy-MM-dd}";
            if (_requete.Au is not null) chemin += $"&au={_requete.Au:yyyy-MM-dd}";

            var resultat = await Api.ObtenirAsync<RapportDto>(chemin);

            if (resultat.Succes) _rapport = resultat.Valeur;
            else Messages.Erreur(resultat.Message);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task Imprimer() => await Js.InvokeVoidAsync("window.print");
}
