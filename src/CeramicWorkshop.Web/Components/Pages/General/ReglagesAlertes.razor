@page "/alertes/reglages"
@attribute [Authorize(Policy = PermissionCodes.ParametresConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Réglages des alertes — CERAMIPRO</PageTitle>

<EntetePage Titre="Réglages des alertes"
            Introduction="Choisissez les alertes affichées et à partir de quel moment elles apparaissent.">
    <Actions>
        <a class="bouton bouton-discret" href="alertes">Retour aux alertes</a>
    </Actions>
</EntetePage>

@if (_chargement)
{
    <Chargement Message="Chargement des réglages…" />
}
else
{
    <div class="liste-reglages">
        @foreach (var reglage in _reglages)
        {
            <article class="carte">
                <h2 class="carte-titre">@reglage.TypeLibelle</h2>
                <p class="carte-texte">@reglage.Explication</p>

                <div class="champ-case">
                    <input type="checkbox" id="@($"actif-{reglage.Id}")" checked="@reglage.Active"
                           disabled="@(!PeutModifier)"
                           @onchange="args => reglage.Active = args.Value is bool coche && coche" />
                    <label for="@($"actif-{reglage.Id}")">Afficher cette alerte</label>
                </div>

                @if (reglage.AttendDesJours)
                {
                    <div class="champ">
                        <label for="@($"jours-{reglage.Id}")">Prévenir combien de jours à l'avance ?</label>
                        <input id="@($"jours-{reglage.Id}")" type="number" min="0" max="365"
                               class="saisie saisie-compacte" value="@reglage.SeuilJours"
                               disabled="@(!PeutModifier)"
                               @onchange="args => reglage.SeuilJours = Entier(args)" />
                    </div>
                }

                @if (reglage.Type is NotificationType.DetteClient or NotificationType.DetteFournisseur)
                {
                    <div class="champ">
                        <label for="@($"montant-{reglage.Id}")">Montant à partir duquel prévenir</label>
                        <input id="@($"montant-{reglage.Id}")" type="number" step="100" min="0"
                               class="saisie saisie-compacte" value="@reglage.SeuilValeur"
                               disabled="@(!PeutModifier)"
                               @onchange="args => reglage.SeuilValeur = Decimal(args)" />
                    </div>
                }

                @if (PeutModifier)
                {
                    <div class="barre-boutons">
                        <button type="button" class="bouton bouton-principal"
                                @onclick="() => Enregistrer(reglage)">Enregistrer</button>
                    </div>
                }
            </article>
        }
    </div>
}

@code {
    private List<ReglageAlerteDto> _reglages = new();
    private bool _chargement = true;

    private bool PeutModifier => Authentification.Session.PossedeDroit(PermissionCodes.ParametresModifier);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resultat = await Api.ObtenirAsync<List<ReglageAlerteDto>>("api/alertes/reglages");

            if (resultat.Succes && resultat.Valeur is not null) _reglages = resultat.Valeur;
            else Messages.Erreur(resultat.Message);
        }
        finally
        {
            _chargement = false;
        }
    }

    private static int? Entier(ChangeEventArgs args)
        => int.TryParse(args.Value?.ToString(), out var valeur) ? valeur : null;

    private static decimal? Decimal(ChangeEventArgs args)
        => decimal.TryParse(args.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var valeur)
            ? valeur
            : null;

    private async Task Enregistrer(ReglageAlerteDto reglage)
    {
        var resultat = await Api.MettreAJourAsync<ReglageAlerteDto>(
            $"api/alertes/reglages/{reglage.Id}", reglage);

        if (resultat.Succes) Messages.Succes($"Réglage « {reglage.TypeLibelle} » enregistré.");
        else Messages.Erreur(resultat.Message);
    }
}
