@page "/sauvegardes"
@attribute [Authorize(Policy = PermissionCodes.SauvegardeGerer)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject AdresseServeur Serveur

<PageTitle>Sauvegardes — CERAMIPRO</PageTitle>

<EntetePage Titre="Sauvegardes"
            Introduction="Mettez vos données à l'abri : une archive par sauvegarde, à copier sur une clé USB.">
    <Actions>
        <button type="button" class="bouton bouton-principal" @onclick="Creer" disabled="@_creation">
            @(_creation ? "Sauvegarde en cours…" : "Sauvegarder maintenant")
        </button>
    </Actions>
</EntetePage>

@if (_chargement)
{
    <Chargement Message="Lecture des sauvegardes…" />
}
else if (_etat is not null)
{
    <div class="bandeau-statistiques">
        <Statistique Valeur="@_etat.Nombre.ToString()" Libelle="sauvegardes conservées" />
        <Statistique Valeur="@(_etat.DerniereSauvegarde is null
                                 ? "Aucune"
                                 : MontantFormatter.FormaterDateHeure(_etat.DerniereSauvegarde.Value))"
                     Libelle="dernière sauvegarde" />
        <Statistique Valeur="@(_etat.AutomatiqueActive ? $"Chaque jour à {_etat.HeureAutomatique}" : "Désactivée")"
                     Libelle="sauvegarde automatique" />
    </div>

    <article class="carte">
        <h2 class="carte-titre">Comment cela fonctionne</h2>
        <p class="carte-texte">
            Chaque sauvegarde est un fichier compressé contenant une copie de toutes les
            tables de l'atelier, lisible dans un tableur. Les fichiers sont enregistrés
            sur le serveur, dans le dossier <code>@_etat.Dossier</code>, et conservés
            @_etat.ConservationJours jours.
        </p>
        <p class="carte-texte">
            La sauvegarde automatique s'active dans l'écran « Paramètres », rubrique
            Sauvegarde. Copiez régulièrement les archives sur un support extérieur à
            l'ordinateur de l'atelier.
        </p>
    </article>

    @if (_etat.Sauvegardes.Count == 0)
    {
        <EtatVide Message="Aucune sauvegarde pour l'instant. Cliquez sur « Sauvegarder maintenant »." />
    }
    else
    {
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr><th>Fichier</th><th>Date</th><th>Origine</th><th class="nombre">Taille</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var sauvegarde in _etat.Sauvegardes)
                {
                    <tr>
                        <td data-libelle="Fichier">@sauvegarde.NomFichier</td>
                        <td data-libelle="Date">@MontantFormatter.FormaterDateHeure(sauvegarde.Date)</td>
                        <td data-libelle="Origine">
                            <span class="etiquette @(sauvegarde.Automatique ? "etiquette-neutre" : "etiquette-succes")">
                                @(sauvegarde.Automatique ? "Automatique" : "Manuelle")
                            </span>
                        </td>
                        <td class="nombre" data-libelle="Taille">@sauvegarde.TailleAffichee</td>
                        <td class="colonne-actions" data-libelle="Actions">
                            <a class="bouton bouton-discret"
                               href="@($"{Serveur.Base}/api/sauvegardes/{sauvegarde.NomFichier}")"
                               target="_blank">Télécharger</a>
                            <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                    @onclick="() => Supprimer(sauvegarde.NomFichier)">Supprimer</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private EtatSauvegardeDto? _etat;
    private bool _chargement = true;
    private bool _creation;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        _chargement = true;

        try
        {
            var resultat = await Api.ObtenirAsync<EtatSauvegardeDto>("api/sauvegardes");

            if (resultat.Succes) _etat = resultat.Valeur;
            else Messages.Erreur(resultat.Message);
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task Creer()
    {
        _creation = true;

        try
        {
            var resultat = await Api.PosterAsync<SauvegardeDto>("api/sauvegardes");

            if (resultat.Succes && resultat.Valeur is not null)
            {
                Messages.Succes($"Sauvegarde {resultat.Valeur.NomFichier} créée ({resultat.Valeur.TailleAffichee}).");
                await Charger();
            }
            else
            {
                Messages.Erreur(resultat.Message);
            }
        }
        finally
        {
            _creation = false;
        }
    }

    private async Task Supprimer(string nomFichier)
    {
        var resultat = await Api.SupprimerAsync($"api/sauvegardes/{nomFichier}");

        if (resultat.Succes)
        {
            Messages.Succes("Sauvegarde supprimée.");
            await Charger();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }
}
