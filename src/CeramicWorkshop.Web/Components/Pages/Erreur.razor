@page "/erreur"
@using System.Diagnostics

<PageTitle>Erreur — CERAMIPRO</PageTitle>

<div class="page-message">
    <div class="page-message-icone">⚠️</div>
    <h1>Une erreur est survenue</h1>
    <p>L'opération n'a pas pu être terminée. Aucune donnée n'a été enregistrée.</p>

    @if (!string.IsNullOrWhiteSpace(_reference))
    {
        <p class="page-message-aide">
            Référence à communiquer à l'administrateur : <code>@_reference</code>
        </p>
    }

    <a class="bouton bouton-principal" href="/">Retour au tableau de bord</a>
</div>

@code {
    private string? _reference;

    [CascadingParameter]
    private HttpContext? Contexte { get; set; }

    protected override void OnInitialized()
        => _reference = Activity.Current?.Id ?? Contexte?.TraceIdentifier;
}
