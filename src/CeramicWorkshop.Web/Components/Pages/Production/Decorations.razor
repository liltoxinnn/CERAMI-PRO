@page "/production/decoration"
@attribute [Authorize(Policy = PermissionCodes.DecorationConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification
@inject AdresseServeur Serveur

<PageTitle>Décoration — CERAMIPRO</PageTitle>

<EntetePage Titre="Décoration"
            Introduction="Émaillage, peinture à la main, dorure et argenture des pièces.">
    <Actions>
        @if (PeutGerer)
        {
            <button type="button" class="bouton bouton-principal" @onclick="OuvrirCreation">+ Nouveau travail</button>
        }
    </Actions>
</EntetePage>

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher une référence, un type, une couleur…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="statut">État</label>
        <select id="statut" class="saisie saisie-compacte" @onchange="FiltrerStatut">
            <option value="">Tous</option>
            @foreach (var (valeur, libelle) in EnumExtensions.Libelles<DecorationStatus>())
            {
                <option value="@valeur">@libelle</option>
            }
        </select>
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des travaux de décoration…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucun travail de décoration enregistré." />
}
else
{
    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Référence</th><th>Type</th><th>Production</th><th class="nombre">Pièces</th>
                <th>Couleurs</th><th class="nombre">Coût</th><th>Employé</th><th>État</th>
                <th class="colonne-actions">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var decoration in _page.Elements)
            {
                <tr>
                    <td data-libelle="Référence"><code>@decoration.Reference</code></td>
                    <td data-libelle="Type">@decoration.TypeDecorationNom</td>
                    <td data-libelle="Production">@(decoration.ProductionNumero ?? "—")</td>
                    <td class="nombre" data-libelle="Pièces">
                        @MontantFormatter.FormaterQuantite(decoration.Quantite)</td>
                    <td data-libelle="Couleurs">@(decoration.Couleurs ?? "—")</td>
                    <td class="nombre" data-libelle="Coût">@MontantFormatter.Formater(decoration.Cout)</td>
                    <td data-libelle="Employé">@(decoration.EmployeNom ?? "—")</td>
                    <td data-libelle="État">
                        <span class="etiquette @ClasseStatut(decoration.Statut)">@decoration.StatutLibelle</span>
                    </td>
                    <td class="colonne-actions" data-libelle="Actions">
                        <button type="button" class="bouton bouton-discret"
                                @onclick="() => OuvrirDetail(decoration)">Détail</button>

                        @if (PeutGerer && decoration.Statut == DecorationStatus.Planifiee)
                        {
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => ChangerStatut(decoration, DecorationStatus.EnCours)">Démarrer</button>
                        }

                        @if (PeutGerer && decoration.Statut == DecorationStatus.EnCours)
                        {
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => ChangerStatut(decoration, DecorationStatus.Terminee)">Terminer</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="DecorationDto" Page="_page" Libelle="travail/travaux" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_formulaireVisible" Large="true" Titre="Nouveau travail de décoration"
         OnFermer="() => _formulaireVisible = false">
    <EditForm Model="_formulaire" OnValidSubmit="Enregistrer" class="formulaire">
        <ResumeErreurs Message="@_erreur" Details="_details" />

        <div class="grille-formulaire">
            <div class="champ">
                <label for="type">Type de décoration</label>
                <InputSelect id="type" class="saisie" @bind-Value="_formulaire.TypeDecorationId">
                    <option value="0">— Choisir —</option>
                    @foreach (var type in _types)
                    {
                        <option value="@type.Id">@type.Nom</option>
                    }
                </InputSelect>
            </div>
            <div class="champ">
                <label for="production">Production concernée</label>
                <InputSelect id="production" class="saisie" @bind-Value="_formulaire.ProductionId">
                    <option value="">Aucune</option>
                    @foreach (var ordre in _productions)
                    {
                        <option value="@ordre.Id">@ordre.Numero — @ordre.ProduitNom</option>
                    }
                </InputSelect>
            </div>
            <div class="champ">
                <label for="quantite">Nombre de pièces</label>
                <InputNumber id="quantite" class="saisie" @bind-Value="_formulaire.Quantite" />
            </div>
            <div class="champ">
                <label for="couleurs">Couleurs</label>
                <InputText id="couleurs" class="saisie" @bind-Value="_formulaire.Couleurs" />
            </div>
            <div class="champ">
                <label for="email">Émail utilisé</label>
                <InputText id="email" class="saisie" @bind-Value="_formulaire.Email" />
            </div>
            <div class="champ">
                <label for="peinture">Peinture utilisée</label>
                <InputText id="peinture" class="saisie" @bind-Value="_formulaire.Peinture" />
            </div>
            <div class="champ">
                <label for="or">Or décoratif (g)</label>
                <InputNumber id="or" class="saisie" @bind-Value="_formulaire.QuantiteOr" />
            </div>
            <div class="champ">
                <label for="argent">Argent décoratif (g)</label>
                <InputNumber id="argent" class="saisie" @bind-Value="_formulaire.QuantiteArgent" />
            </div>
            <div class="champ">
                <label for="cout">Coût de la décoration</label>
                <InputNumber id="cout" class="saisie" @bind-Value="_formulaire.Cout" />
            </div>
            <div class="champ">
                <label for="employe">Employé responsable</label>
                <InputSelect id="employe" class="saisie" @bind-Value="_formulaire.EmployeId">
                    <option value="">Non assigné</option>
                    @foreach (var employe in _employes)
                    {
                        <option value="@employe.Id">@employe.NomComplet</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="champ">
            <label for="materiaux">Matériaux utilisés</label>
            <InputTextArea id="materiaux" class="saisie saisie-multiligne" rows="2"
                           @bind-Value="_formulaire.MateriauxUtilises" />
        </div>

        <div class="champ">
            <label for="notes">Notes</label>
            <InputTextArea id="notes" class="saisie saisie-multiligne" rows="2" @bind-Value="_formulaire.Notes" />
        </div>

        <div class="fenetre-actions">
            <button type="button" class="bouton bouton-secondaire"
                    @onclick="() => _formulaireVisible = false">Annuler</button>
            <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                @(_enregistrement ? "Enregistrement…" : "Enregistrer")
            </button>
        </div>
    </EditForm>
</Fenetre>

<Fenetre Visible="_detailVisible" Large="true" Titre="@($"Décoration {_referenceEnCours}")"
         OnFermer="() => _detailVisible = false">
    @if (_detail is not null)
    {
        <div class="detail-grille">
            <div><span class="champ-aide">Type</span><br /><strong>@_detail.TypeDecorationNom</strong></div>
            <div><span class="champ-aide">État</span><br />@_detail.StatutLibelle</div>
            <div><span class="champ-aide">Pièces</span><br />
                @MontantFormatter.FormaterQuantite(_detail.Quantite)</div>
            <div><span class="champ-aide">Couleurs</span><br />@(_detail.Couleurs ?? "—")</div>
            <div><span class="champ-aide">Émail</span><br />@(_detail.Email ?? "—")</div>
            <div><span class="champ-aide">Peinture</span><br />@(_detail.Peinture ?? "—")</div>
            <div><span class="champ-aide">Or décoratif</span><br />
                @(_detail.QuantiteOr is null ? "—" : MontantFormatter.FormaterQuantite(_detail.QuantiteOr.Value, "g"))</div>
            <div><span class="champ-aide">Argent décoratif</span><br />
                @(_detail.QuantiteArgent is null ? "—" : MontantFormatter.FormaterQuantite(_detail.QuantiteArgent.Value, "g"))</div>
            <div><span class="champ-aide">Coût</span><br />@MontantFormatter.Formater(_detail.Cout)</div>
        </div>

        @if (PeutGerer)
        {
            <TeleversementFichier Libelle="Ajouter une photo du décor"
                                  TypesAcceptes="image/jpeg,image/png,image/webp" OnDepose="AjouterPhoto" />
        }

        @if (_detail.Photos.Count > 0)
        {
            <div class="galerie">
                @foreach (var photo in _detail.Photos)
                {
                    <figure class="galerie-element">
                        <img src="@Serveur.Fichier(photo)" alt="Photo du décor" />
                    </figure>
                }
            </div>
        }
    }
</Fenetre>

@code {
    private PagedResult<DecorationDto>? _page;
    private DecorationDto? _detail;
    private List<ElementReferentielDto> _types = new();
    private List<OrdreProductionDto> _productions = new();
    private List<UtilisateurDto> _employes = new();

    private FiltreDecorationsRequete _filtre = new();
    private DecorationRequete _formulaire = new();

    private bool _chargement = true;
    private bool _formulaireVisible, _detailVisible, _enregistrement;
    private int _idEnCours;
    private string _referenceEnCours = string.Empty;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutGerer => Authentification.Session.PossedeDroit(PermissionCodes.DecorationGerer);

    private static string ClasseStatut(DecorationStatus statut) => statut switch
    {
        DecorationStatus.Terminee => "etiquette-succes",
        DecorationStatus.Annulee => "etiquette-danger",
        DecorationStatus.EnCours => "etiquette-attention",
        _ => "etiquette-neutre"
    };

    protected override async Task OnInitializedAsync()
    {
        var types = await Api.ObtenirAsync<List<ElementReferentielDto>>(
            "api/referentiels/TypeDecoration?inclureInactifs=false");
        if (types.Succes && types.Valeur is not null) _types = types.Valeur;

        var productions = await Api.ObtenirAsync<PagedResult<OrdreProductionDto>>(
            "api/production?taillePage=100&seulementEnCours=true");
        if (productions.Succes && productions.Valeur is not null)
            _productions = productions.Valeur.Elements.ToList();

        var employes = await Api.ObtenirAsync<PagedResult<UtilisateurDto>>("api/utilisateurs?taillePage=100");
        if (employes.Succes && employes.Valeur is not null)
            _employes = employes.Valeur.Elements.Where(u => u.Actif).ToList();

        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/decorations?page={_filtre.Page}&taillePage={_filtre.TaillePage}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        if (_filtre.Statut is not null) chemin += $"&statut={_filtre.Statut}";

        var resultat = await Api.ObtenirAsync<PagedResult<DecorationDto>>(chemin);
        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerStatut(ChangeEventArgs args)
    {
        _filtre.Statut = Enum.TryParse<DecorationStatus>(args.Value?.ToString(), out var statut) ? statut : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private void OuvrirCreation()
    {
        _formulaire = new DecorationRequete();
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireVisible = true;
    }

    private async Task OuvrirDetail(DecorationDto decoration)
    {
        var resultat = await Api.ObtenirAsync<DecorationDto>($"api/decorations/{decoration.Id}");

        if (!resultat.Succes)
        {
            Messages.Erreur(resultat.Message);
            return;
        }

        _detail = resultat.Valeur;
        _idEnCours = decoration.Id;
        _referenceEnCours = decoration.Reference;
        _detailVisible = true;
    }

    private async Task Enregistrer()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<DecorationDto>("api/decorations", _formulaire);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Travail de décoration {resultat.Valeur!.Reference} enregistré.");
            _formulaireVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task ChangerStatut(DecorationDto decoration, DecorationStatus statut)
    {
        var resultat = await Api.PosterAsync<DecorationDto>(
            $"api/decorations/{decoration.Id}/statut", new { Statut = statut });

        if (resultat.Succes)
        {
            Messages.Succes($"Décoration {decoration.Reference} : {statut.Libelle()}.");
            await ChargerAsync();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }

    private async Task AjouterPhoto(string chemin)
    {
        var resultat = await Api.PosterAsync<DecorationDto>(
            $"api/decorations/{_idEnCours}/photos", new { Chemin = chemin, Legende = (string?)null });

        if (resultat.Succes)
        {
            Messages.Succes("Photo ajoutée.");
            _detail = resultat.Valeur;
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }
}
