@page "/parametres/listes"
@attribute [Authorize(Policy = PermissionCodes.MatieresConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Listes de référence — CERAMIPRO</PageTitle>

<EntetePage Titre="Listes de référence"
            Introduction="Catégories et unités utilisées partout dans le logiciel. Une entrée déjà utilisée se désactive au lieu d'être supprimée." />

<div class="onglets">
    @foreach (var (valeur, libelle) in EnumExtensions.Libelles<TypeReferentiel>())
    {
        <button type="button" class="onglet @(_ongletUnites == false && _type == valeur ? "actif" : "")"
                @onclick="() => ChoisirReferentiel(valeur)">@libelle</button>
    }
    <button type="button" class="onglet @(_ongletUnites ? "actif" : "")"
            @onclick="ChoisirUnites">Unités de mesure</button>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement…" />
}
else if (_ongletUnites)
{
    <div class="page-entete">
        <div></div>
        @if (PeutGerer)
        {
            <button type="button" class="bouton bouton-principal" @onclick="OuvrirCreationUnite">+ Nouvelle unité</button>
        }
    </div>

    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr><th>Code</th><th>Nom</th><th>Famille</th><th class="nombre">Facteur</th>
                <th class="nombre">Utilisations</th><th>État</th>
                @if (PeutGerer) { <th class="colonne-actions">Actions</th> }
            </tr>
            </thead>
            <tbody>
            @foreach (var unite in _unites)
            {
                <tr>
                    <td data-libelle="Code"><code>@unite.Code</code></td>
                    <td data-libelle="Nom">@unite.Nom</td>
                    <td data-libelle="Famille">@unite.TypeLibelle</td>
                    <td class="nombre" data-libelle="Facteur">@MontantFormatter.FormaterQuantite(unite.FacteurConversion)</td>
                    <td class="nombre" data-libelle="Utilisations">@unite.NombreUtilisations</td>
                    <td data-libelle="État">
                        <span class="etiquette @(unite.Actif ? "etiquette-succes" : "etiquette-neutre")">
                            @(unite.Actif ? "Active" : "Inactive")
                        </span>
                    </td>
                    @if (PeutGerer)
                    {
                        <td class="colonne-actions" data-libelle="Actions">
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirModificationUnite(unite)">Modifier</button>
                            @if (!unite.Systeme && unite.NombreUtilisations == 0)
                            {
                                <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                        @onclick="() => SupprimerUnite(unite)">Supprimer</button>
                            }
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="page-entete">
        <div></div>
        @if (PeutGerer)
        {
            <button type="button" class="bouton bouton-principal" @onclick="OuvrirCreationElement">+ Ajouter</button>
        }
    </div>

    @if (_elements.Count == 0)
    {
        <EtatVide Message="Cette liste est vide." />
    }
    else
    {
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr><th>Nom</th><th>Description</th><th class="nombre">Utilisations</th><th>État</th>
                    @if (PeutGerer) { <th class="colonne-actions">Actions</th> }
                </tr>
                </thead>
                <tbody>
                @foreach (var element in _elements)
                {
                    <tr>
                        <td data-libelle="Nom">@element.Nom</td>
                        <td data-libelle="Description">@(element.Description ?? "—")</td>
                        <td class="nombre" data-libelle="Utilisations">@element.NombreUtilisations</td>
                        <td data-libelle="État">
                            <span class="etiquette @(element.Actif ? "etiquette-succes" : "etiquette-neutre")">
                                @(element.Actif ? "Active" : "Inactive")
                            </span>
                        </td>
                        @if (PeutGerer)
                        {
                            <td class="colonne-actions" data-libelle="Actions">
                                <button type="button" class="bouton bouton-discret"
                                        @onclick="() => OuvrirModificationElement(element)">Modifier</button>
                                @if (!element.Systeme && element.NombreUtilisations == 0)
                                {
                                    <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                            @onclick="() => SupprimerElement(element)">Supprimer</button>
                                }
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}

<Fenetre Visible="_formulaireElementVisible" Titre="@(_creation ? "Nouvel élément" : "Modifier l'élément")"
         OnFermer="() => _formulaireElementVisible = false">
    <EditForm Model="_element" OnValidSubmit="EnregistrerElement" class="formulaire">
        <ResumeErreurs Message="@_erreur" Details="_details" />

        <div class="champ">
            <label for="nom-element">Nom</label>
            <InputText id="nom-element" class="saisie" @bind-Value="_element.Nom" />
        </div>

        <div class="champ">
            <label for="desc-element">Description</label>
            <InputTextArea id="desc-element" class="saisie saisie-multiligne" rows="2"
                           @bind-Value="_element.Description" />
        </div>

        <div class="champ-case">
            <InputCheckbox id="actif-element" @bind-Value="_element.Actif" />
            <label for="actif-element">Active</label>
        </div>

        <div class="fenetre-actions">
            <button type="button" class="bouton bouton-secondaire"
                    @onclick="() => _formulaireElementVisible = false">Annuler</button>
            <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                @(_enregistrement ? "Enregistrement…" : "Enregistrer")
            </button>
        </div>
    </EditForm>
</Fenetre>

<Fenetre Visible="_formulaireUniteVisible" Titre="@(_creation ? "Nouvelle unité" : "Modifier l'unité")"
         OnFermer="() => _formulaireUniteVisible = false">
    <EditForm Model="_unite" OnValidSubmit="EnregistrerUnite" class="formulaire">
        <ResumeErreurs Message="@_erreur" Details="_details" />

        <div class="grille-formulaire">
            <div class="champ">
                <label for="code-unite">Code</label>
                <InputText id="code-unite" class="saisie" @bind-Value="_unite.Code" />
            </div>
            <div class="champ">
                <label for="nom-unite">Nom</label>
                <InputText id="nom-unite" class="saisie" @bind-Value="_unite.Nom" />
            </div>
            <div class="champ">
                <label for="type-unite">Famille</label>
                <InputSelect id="type-unite" class="saisie" @bind-Value="_unite.Type">
                    @foreach (var (valeur, libelle) in EnumExtensions.Libelles<UnitType>())
                    {
                        <option value="@valeur">@libelle</option>
                    }
                </InputSelect>
            </div>
            <div class="champ">
                <label for="facteur">Facteur de conversion</label>
                <InputNumber id="facteur" class="saisie" @bind-Value="_unite.FacteurConversion" />
                <span class="champ-aide">Par rapport à l'unité de référence de la famille (g → kg = 0,001).</span>
            </div>
        </div>

        <div class="champ-case">
            <InputCheckbox id="actif-unite" @bind-Value="_unite.Actif" />
            <label for="actif-unite">Active</label>
        </div>

        <div class="fenetre-actions">
            <button type="button" class="bouton bouton-secondaire"
                    @onclick="() => _formulaireUniteVisible = false">Annuler</button>
            <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                @(_enregistrement ? "Enregistrement…" : "Enregistrer")
            </button>
        </div>
    </EditForm>
</Fenetre>

@code {
    private TypeReferentiel _type = TypeReferentiel.CategorieMatiere;
    private bool _ongletUnites;

    private List<ElementReferentielDto> _elements = new();
    private List<UniteDto> _unites = new();

    private ElementReferentielRequete _element = new();
    private UniteRequete _unite = new();

    private bool _chargement = true;
    private bool _formulaireElementVisible, _formulaireUniteVisible;
    private bool _creation, _enregistrement;
    private int _idEnCours;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutGerer => Authentification.Session.PossedeDroit(PermissionCodes.MatieresGerer);

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;

        if (_ongletUnites)
        {
            var unites = await Api.ObtenirAsync<List<UniteDto>>("api/unites");
            if (unites.Succes && unites.Valeur is not null) _unites = unites.Valeur;
            else Messages.Erreur(unites.Message);
        }
        else
        {
            var elements = await Api.ObtenirAsync<List<ElementReferentielDto>>($"api/referentiels/{_type}");
            if (elements.Succes && elements.Valeur is not null) _elements = elements.Valeur;
            else Messages.Erreur(elements.Message);
        }

        _chargement = false;
    }

    private async Task ChoisirReferentiel(TypeReferentiel type)
    {
        _type = type;
        _ongletUnites = false;
        await ChargerAsync();
    }

    private async Task ChoisirUnites()
    {
        _ongletUnites = true;
        await ChargerAsync();
    }

    private void OuvrirCreationElement()
    {
        _creation = true;
        _idEnCours = 0;
        _element = new ElementReferentielRequete { Actif = true };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireElementVisible = true;
    }

    private void OuvrirModificationElement(ElementReferentielDto element)
    {
        _creation = false;
        _idEnCours = element.Id;
        _element = new ElementReferentielRequete
        {
            Nom = element.Nom, Description = element.Description, Actif = element.Actif
        };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireElementVisible = true;
    }

    private void OuvrirCreationUnite()
    {
        _creation = true;
        _idEnCours = 0;
        _unite = new UniteRequete { Actif = true, FacteurConversion = 1m };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireUniteVisible = true;
    }

    private void OuvrirModificationUnite(UniteDto unite)
    {
        _creation = false;
        _idEnCours = unite.Id;
        _unite = new UniteRequete
        {
            Code = unite.Code, Nom = unite.Nom, Type = unite.Type,
            FacteurConversion = unite.FacteurConversion, Actif = unite.Actif
        };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireUniteVisible = true;
    }

    private async Task EnregistrerElement()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = _creation
                ? await Api.PosterAsync<ElementReferentielDto>($"api/referentiels/{_type}", _element)
                : await Api.MettreAJourAsync<ElementReferentielDto>($"api/referentiels/{_type}/{_idEnCours}", _element);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes(_creation ? "Élément ajouté." : "Élément modifié.");
            _formulaireElementVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task EnregistrerUnite()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = _creation
                ? await Api.PosterAsync<UniteDto>("api/unites", _unite)
                : await Api.MettreAJourAsync<UniteDto>($"api/unites/{_idEnCours}", _unite);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes(_creation ? "Unité créée." : "Unité modifiée.");
            _formulaireUniteVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task SupprimerElement(ElementReferentielDto element)
    {
        var resultat = await Api.SupprimerAsync($"api/referentiels/{_type}/{element.Id}");

        if (resultat.Succes)
        {
            Messages.Succes($"« {element.Nom} » supprimé.");
            await ChargerAsync();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }

    private async Task SupprimerUnite(UniteDto unite)
    {
        var resultat = await Api.SupprimerAsync($"api/unites/{unite.Id}");

        if (resultat.Succes)
        {
            Messages.Succes($"Unité « {unite.Nom} » supprimée.");
            await ChargerAsync();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }
}
