@page "/stock/mouvements"
@attribute [Authorize(Policy = PermissionCodes.MouvementsConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Mouvements de stock — CERAMIPRO</PageTitle>

<EntetePage Titre="Mouvements de stock"
            Introduction="Chaque entrée et chaque sortie est enregistrée : rien ne bouge sans laisser de trace.">
    <Actions>
        @if (PeutGerer)
        {
            <button type="button" class="bouton bouton-principal" @onclick="OuvrirRegularisation">
                Régulariser après comptage
            </button>
        }
    </Actions>
</EntetePage>

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher un article ou un document…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="type-article">Type d'article</label>
        <select id="type-article" class="saisie saisie-compacte" @onchange="FiltrerTypeArticle">
            <option value="">Tous</option>
            <option value="MatierePremiere">Matières premières</option>
            <option value="ProduitFini">Produits finis</option>
        </select>
    </div>

    <div class="champ">
        <label for="type-mvt">Type de mouvement</label>
        <select id="type-mvt" class="saisie saisie-compacte" @onchange="FiltrerTypeMouvement">
            <option value="">Tous</option>
            @foreach (var (valeur, libelle) in EnumExtensions.Libelles<InventoryTransactionType>())
            {
                <option value="@valeur">@libelle</option>
            }
        </select>
    </div>

    <div class="champ">
        <label for="du">Du</label>
        <input id="du" type="date" class="saisie saisie-compacte" @onchange="FiltrerDu" />
    </div>

    <div class="champ">
        <label for="au">Au</label>
        <input id="au" type="date" class="saisie saisie-compacte" @onchange="FiltrerAu" />
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des mouvements…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucun mouvement ne correspond à ces critères." />
}
else
{
    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Date</th><th>Article</th><th>Type</th><th class="nombre">Quantité</th>
                <th class="nombre">Avant</th><th class="nombre">Après</th><th class="nombre">Valeur</th>
                <th>Document</th><th>Par</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var mouvement in _page.Elements)
            {
                <tr>
                    <td data-libelle="Date">@MontantFormatter.FormaterDateHeure(mouvement.Date.ToLocalTime())</td>
                    <td data-libelle="Article">
                        @mouvement.Article
                        @if (!string.IsNullOrWhiteSpace(mouvement.ReferenceArticle))
                        {
                            <br /><code>@mouvement.ReferenceArticle</code>
                        }
                    </td>
                    <td data-libelle="Type">@mouvement.TypeMouvement</td>
                    <td class="nombre" data-libelle="Quantité">
                        <span class="etiquette @(mouvement.Quantite >= 0 ? "etiquette-succes" : "etiquette-attention")">
                            @(mouvement.Quantite >= 0 ? "+" : "")@MontantFormatter.FormaterQuantite(mouvement.Quantite, mouvement.Unite)
                        </span>
                    </td>
                    <td class="nombre" data-libelle="Avant">@MontantFormatter.FormaterQuantite(mouvement.StockAvant)</td>
                    <td class="nombre" data-libelle="Après">@MontantFormatter.FormaterQuantite(mouvement.StockApres)</td>
                    <td class="nombre" data-libelle="Valeur">@MontantFormatter.Formater(mouvement.CoutTotal)</td>
                    <td data-libelle="Document">@(mouvement.Document ?? "—")</td>
                    <td data-libelle="Par">@(mouvement.Utilisateur ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="MouvementStockDto" Page="_page" Libelle="mouvement(s)" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_regularisationVisible" Titre="Régularisation de stock"
         OnFermer="() => _regularisationVisible = false">
    <EditForm Model="_regularisation" OnValidSubmit="Regulariser" class="formulaire">
        <ResumeErreurs Message="@_erreur" Details="_details" />

        <p class="carte-texte">
            Après un comptage physique, indiquez la quantité réellement présente.
            L'écart sera enregistré comme mouvement justifié.
        </p>

        <div class="champ">
            <label for="matiere">Matière première</label>
            <InputSelect id="matiere" class="saisie" @bind-Value="_regularisation.MatiereId">
                <option value="">— Choisir —</option>
                @foreach (var matiere in _matieres)
                {
                    <option value="@matiere.Id">
                        @matiere.Nom — stock : @MontantFormatter.FormaterQuantite(matiere.QuantiteActuelle, matiere.UniteCode)
                    </option>
                }
            </InputSelect>
        </div>

        <div class="champ">
            <label for="comptee">Quantité comptée</label>
            <InputNumber id="comptee" class="saisie" @bind-Value="_regularisation.QuantiteComptee" />
        </div>

        <div class="champ">
            <label for="motif">Motif</label>
            <InputSelect id="motif" class="saisie" @bind-Value="_regularisation.Motif">
                @foreach (var (valeur, libelle) in EnumExtensions.Libelles<StockAdjustmentReason>())
                {
                    <option value="@valeur">@libelle</option>
                }
            </InputSelect>
        </div>

        <div class="champ">
            <label for="notes">Notes</label>
            <InputTextArea id="notes" class="saisie saisie-multiligne" rows="2" @bind-Value="_regularisation.Notes" />
        </div>

        <div class="fenetre-actions">
            <button type="button" class="bouton bouton-secondaire"
                    @onclick="() => _regularisationVisible = false">Annuler</button>
            <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                @(_enregistrement ? "Enregistrement…" : "Enregistrer la régularisation")
            </button>
        </div>
    </EditForm>
</Fenetre>

@code {
    private PagedResult<MouvementStockDto>? _page;
    private List<MatiereDto> _matieres = new();
    private FiltreMouvementsRequete _filtre = new();
    private RegularisationRequete _regularisation = new();

    private bool _chargement = true;
    private bool _regularisationVisible;
    private bool _enregistrement;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutGerer => Authentification.Session.PossedeDroit(PermissionCodes.MouvementsGerer);

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/mouvements?page={_filtre.Page}&taillePage={_filtre.TaillePage}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        if (_filtre.TypeArticle is not null) chemin += $"&typeArticle={_filtre.TypeArticle}";
        if (_filtre.TypeMouvement is not null) chemin += $"&typeMouvement={_filtre.TypeMouvement}";
        if (_filtre.Du is not null) chemin += $"&du={_filtre.Du:yyyy-MM-dd}";
        if (_filtre.Au is not null) chemin += $"&au={_filtre.Au:yyyy-MM-dd}";

        var resultat = await Api.ObtenirAsync<PagedResult<MouvementStockDto>>(chemin);

        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerTypeArticle(ChangeEventArgs args)
    {
        _filtre.TypeArticle = Enum.TryParse<InventoryItemType>(args.Value?.ToString(), out var type) ? type : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerTypeMouvement(ChangeEventArgs args)
    {
        _filtre.TypeMouvement = Enum.TryParse<InventoryTransactionType>(args.Value?.ToString(), out var type)
            ? type : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerDu(ChangeEventArgs args)
    {
        _filtre.Du = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerAu(ChangeEventArgs args)
    {
        _filtre.Au = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private async Task OuvrirRegularisation()
    {
        _regularisation = new RegularisationRequete { TypeArticle = InventoryItemType.MatierePremiere };
        _erreur = null;
        _details = Array.Empty<string>();

        var matieres = await Api.ObtenirAsync<PagedResult<MatiereDto>>("api/matieres?taillePage=200");
        if (matieres.Succes && matieres.Valeur is not null) _matieres = matieres.Valeur.Elements.ToList();

        _regularisationVisible = true;
    }

    private async Task Regulariser()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<MouvementStockDto>("api/mouvements/regularisation", _regularisation);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes("Régularisation enregistrée.");
            _regularisationVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }
}
