@page "/stock/matieres"
@attribute [Authorize(Policy = PermissionCodes.MatieresConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Matières premières — CERAMIPRO</PageTitle>

<EntetePage Titre="Matières premières"
            Introduction="Argile, émaux, pigments, peinture, or et argent décoratifs, emballage et consommables.">
    <Actions>
        @if (PeutGerer)
        {
            <button type="button" class="bouton bouton-principal" @onclick="OuvrirCreation">+ Nouvelle matière</button>
        }
    </Actions>
</EntetePage>

@if (_synthese is not null)
{
    <div class="bandeau-statistiques">
        <Statistique Valeur="@_synthese.NombreArticles.ToString()" Libelle="matières actives" />
        <Statistique Valeur="@_synthese.NombreStockFaible.ToString()" Libelle="en alerte de stock"
                     Alerte="@(_synthese.NombreStockFaible > 0)" />
        <Statistique Valeur="@Montant(_synthese.ValeurTotale)" Libelle="valeur du stock" />
    </div>
}

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher un nom, une référence, un emplacement…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="categorie">Catégorie</label>
        <select id="categorie" class="saisie saisie-compacte" value="@(_filtre.CategorieId?.ToString() ?? "")"
                @onchange="FiltrerCategorie">
            <option value="">Toutes</option>
            @foreach (var categorie in _categories)
            {
                <option value="@categorie.Id">@categorie.Nom</option>
            }
        </select>
    </div>

    <div class="champ-case">
        <input type="checkbox" id="alerte" checked="@_filtre.SeulementStockFaible" @onchange="BasculerAlerte" />
        <label for="alerte">Seulement le stock faible</label>
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des matières premières…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucune matière première ne correspond à votre recherche." />
}
else
{
    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Référence</th>
                <th>Nom</th>
                <th>Catégorie</th>
                <th class="nombre">Stock</th>
                <th class="nombre">Minimum</th>
                <th class="nombre">Coût moyen</th>
                <th class="nombre">Valeur</th>
                <th>État</th>
                @if (PeutGerer)
                {
                    <th class="colonne-actions">Actions</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var matiere in _page.Elements)
            {
                <tr>
                    <td data-libelle="Référence"><code>@matiere.Reference</code></td>
                    <td data-libelle="Nom">
                        @matiere.Nom
                        @if (!matiere.Actif)
                        {
                            <span class="etiquette etiquette-neutre">Inactive</span>
                        }
                    </td>
                    <td data-libelle="Catégorie">@matiere.CategorieNom</td>
                    <td class="nombre" data-libelle="Stock">
                        @MontantFormatter.FormaterQuantite(matiere.QuantiteActuelle, matiere.UniteCode)
                    </td>
                    <td class="nombre" data-libelle="Minimum">
                        @MontantFormatter.FormaterQuantite(matiere.StockMinimum, matiere.UniteCode)
                    </td>
                    <td class="nombre" data-libelle="Coût moyen">@Montant(matiere.CoutMoyen)</td>
                    <td class="nombre" data-libelle="Valeur">@Montant(matiere.ValeurStock)</td>
                    <td data-libelle="État">
                        <span class="etiquette @(matiere.StockFaible ? "etiquette-danger" : "etiquette-succes")">
                            @(matiere.StockFaible ? "À réapprovisionner" : "Suffisant")
                        </span>
                    </td>
                    @if (PeutGerer)
                    {
                        <td class="colonne-actions" data-libelle="Actions">
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirModification(matiere)">Modifier</button>
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirLots(matiere)">Lots</button>
                            <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                    @onclick="() => DemanderSuppression(matiere)">Supprimer</button>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="MatiereDto" Page="_page" Libelle="matière(s)" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_formulaireVisible" Large="true"
         Titre="@(_creation ? "Nouvelle matière première" : $"Modifier « {_nomEnCours} »")"
         OnFermer="() => _formulaireVisible = false">
    <EditForm Model="_formulaire" OnValidSubmit="Enregistrer" class="formulaire">
        <ResumeErreurs Message="@_erreur" Details="_details" />

        <div class="grille-formulaire">
            <div class="champ">
                <label for="nom">Nom de la matière</label>
                <InputText id="nom" class="saisie" @bind-Value="_formulaire.Nom" />
            </div>

            <div class="champ">
                <label for="cat">Catégorie</label>
                <InputSelect id="cat" class="saisie" @bind-Value="_formulaire.CategorieId">
                    <option value="0">— Choisir —</option>
                    @foreach (var categorie in _categories)
                    {
                        <option value="@categorie.Id">@categorie.Nom</option>
                    }
                </InputSelect>
            </div>

            <div class="champ">
                <label for="unite">Unité de mesure</label>
                <InputSelect id="unite" class="saisie" @bind-Value="_formulaire.UniteId">
                    <option value="0">— Choisir —</option>
                    @foreach (var unite in _unites)
                    {
                        <option value="@unite.Id">@unite.Nom (@unite.Code)</option>
                    }
                </InputSelect>
            </div>

            <div class="champ">
                <label for="fournisseur">Fournisseur habituel</label>
                <InputSelect id="fournisseur" class="saisie" @bind-Value="_formulaire.FournisseurId">
                    <option value="">Aucun</option>
                    @foreach (var fournisseur in _fournisseurs)
                    {
                        <option value="@fournisseur.Id">@fournisseur.Nom</option>
                    }
                </InputSelect>
            </div>

            <div class="champ">
                <label for="min">Stock minimum (alerte)</label>
                <InputNumber id="min" class="saisie" @bind-Value="_formulaire.StockMinimum" />
            </div>

            <div class="champ">
                <label for="max">Stock maximum</label>
                <InputNumber id="max" class="saisie" @bind-Value="_formulaire.StockMaximum" />
            </div>

            <div class="champ">
                <label for="prix">Prix d'achat unitaire</label>
                <InputNumber id="prix" class="saisie" @bind-Value="_formulaire.PrixAchat" />
            </div>

            @if (_creation)
            {
                <div class="champ">
                    <label for="initial">Quantité déjà en stock</label>
                    <InputNumber id="initial" class="saisie" @bind-Value="_formulaire.StockInitial" />
                    <span class="champ-aide">Enregistrée comme mouvement d'entrée.</span>
                </div>
            }

            <div class="champ">
                <label for="emplacement">Emplacement</label>
                <InputText id="emplacement" class="saisie" @bind-Value="_formulaire.Emplacement" />
            </div>
        </div>

        <div class="champ">
            <label for="description">Description</label>
            <InputTextArea id="description" class="saisie saisie-multiligne" rows="2"
                           @bind-Value="_formulaire.Description" />
        </div>

        <div class="champ-case">
            <InputCheckbox id="actif" @bind-Value="_formulaire.Actif" />
            <label for="actif">Matière active</label>
        </div>

        <div class="fenetre-actions">
            <button type="button" class="bouton bouton-secondaire"
                    @onclick="() => _formulaireVisible = false">Annuler</button>
            <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                @(_enregistrement ? "Enregistrement…" : "Enregistrer")
            </button>
        </div>
    </EditForm>
</Fenetre>

<Fenetre Visible="_lotsVisibles" Large="true" Titre="@($"Lots reçus — {_nomEnCours}")"
         OnFermer="() => _lotsVisibles = false">
    @if (_lots.Count == 0)
    {
        <EtatVide Message="Aucun lot reçu pour cette matière." />
    }
    else
    {
        <div class="tableau-defilant">
            <table class="tableau">
                <thead>
                <tr>
                    <th>Lot</th><th>Reçu le</th><th class="nombre">Quantité</th>
                    <th class="nombre">Restant</th><th class="nombre">Coût unitaire</th><th>Emplacement</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var lot in _lots)
                {
                    <tr>
                        <td data-libelle="Lot"><code>@lot.Numero</code></td>
                        <td data-libelle="Reçu le">@MontantFormatter.FormaterDate(lot.DateReception.ToLocalTime())</td>
                        <td class="nombre" data-libelle="Quantité">@MontantFormatter.FormaterQuantite(lot.Quantite)</td>
                        <td class="nombre" data-libelle="Restant">@MontantFormatter.FormaterQuantite(lot.QuantiteRestante)</td>
                        <td class="nombre" data-libelle="Coût unitaire">@Montant(lot.CoutUnitaire)</td>
                        <td data-libelle="Emplacement">@(lot.Emplacement ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</Fenetre>

<BoiteConfirmation Visible="_confirmationVisible" Titre="Supprimer la matière"
                   Texte="@_texteConfirmation" LibelleConfirmation="Supprimer" Dangereux="true"
                   OnConfirmer="ConfirmerSuppression" OnAnnuler="() => _confirmationVisible = false" />

@code {
    private PagedResult<MatiereDto>? _page;
    private SyntheseStockDto? _synthese;
    private List<ElementReferentielDto> _categories = new();
    private List<UniteDto> _unites = new();
    private List<FournisseurDto> _fournisseurs = new();
    private List<LotMatiereDto> _lots = new();

    private FiltreMatieresRequete _filtre = new();
    private MatiereRequete _formulaire = new();

    private bool _chargement = true;
    private bool _formulaireVisible;
    private bool _lotsVisibles;
    private bool _confirmationVisible;
    private bool _creation;
    private bool _enregistrement;

    private int _idEnCours;
    private string _nomEnCours = string.Empty;
    private string _texteConfirmation = string.Empty;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutGerer => Authentification.Session.PossedeDroit(PermissionCodes.MatieresGerer);

    private static string Montant(decimal valeur) => MontantFormatter.Formater(valeur);

    protected override async Task OnInitializedAsync()
    {
        var categories = await Api.ObtenirAsync<List<ElementReferentielDto>>(
            "api/referentiels/CategorieMatiere?inclureInactifs=false");
        if (categories.Succes && categories.Valeur is not null) _categories = categories.Valeur;

        var unites = await Api.ObtenirAsync<List<UniteDto>>("api/unites?inclureInactives=false");
        if (unites.Succes && unites.Valeur is not null) _unites = unites.Valeur;

        var fournisseurs = await Api.ObtenirAsync<PagedResult<FournisseurDto>>("api/fournisseurs?taillePage=200");
        if (fournisseurs.Succes && fournisseurs.Valeur is not null)
            _fournisseurs = fournisseurs.Valeur.Elements.ToList();

        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/matieres?page={_filtre.Page}&taillePage={_filtre.TaillePage}" +
                     $"&seulementStockFaible={_filtre.SeulementStockFaible}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
        {
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        }

        if (_filtre.CategorieId is not null)
        {
            chemin += $"&categorieId={_filtre.CategorieId}";
        }

        var resultat = await Api.ObtenirAsync<PagedResult<MatiereDto>>(chemin);

        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        var synthese = await Api.ObtenirAsync<SyntheseStockDto>("api/matieres/synthese");
        if (synthese.Succes) _synthese = synthese.Valeur;

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerCategorie(ChangeEventArgs args)
    {
        _filtre.CategorieId = int.TryParse(args.Value?.ToString(), out var id) ? id : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task BasculerAlerte(ChangeEventArgs args)
    {
        _filtre.SeulementStockFaible = args.Value is true;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private void OuvrirCreation()
    {
        _creation = true;
        _idEnCours = 0;
        _nomEnCours = string.Empty;
        _formulaire = new MatiereRequete { Actif = true };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireVisible = true;
    }

    private void OuvrirModification(MatiereDto matiere)
    {
        _creation = false;
        _idEnCours = matiere.Id;
        _nomEnCours = matiere.Nom;
        _formulaire = new MatiereRequete
        {
            Nom = matiere.Nom,
            CategorieId = matiere.CategorieId,
            UniteId = matiere.UniteId,
            StockMinimum = matiere.StockMinimum,
            StockMaximum = matiere.StockMaximum,
            PrixAchat = matiere.PrixDernierAchat,
            FournisseurId = matiere.FournisseurId,
            Emplacement = matiere.Emplacement,
            Description = matiere.Description,
            Image = matiere.Image,
            Actif = matiere.Actif
        };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireVisible = true;
    }

    private async Task OuvrirLots(MatiereDto matiere)
    {
        _nomEnCours = matiere.Nom;
        var resultat = await Api.ObtenirAsync<List<LotMatiereDto>>($"api/matieres/{matiere.Id}/lots");
        _lots = resultat.Succes && resultat.Valeur is not null ? resultat.Valeur : new List<LotMatiereDto>();
        _lotsVisibles = true;
    }

    private async Task Enregistrer()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = _creation
                ? await Api.PosterAsync<MatiereDto>("api/matieres", _formulaire)
                : await Api.MettreAJourAsync<MatiereDto>($"api/matieres/{_idEnCours}", _formulaire);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes(_creation ? "Matière créée." : "Matière modifiée.");
            _formulaireVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private void DemanderSuppression(MatiereDto matiere)
    {
        _idEnCours = matiere.Id;
        _nomEnCours = matiere.Nom;
        _texteConfirmation = $"La matière « {matiere.Nom} » sera supprimée. " +
                             "Cette action n'est possible que si elle n'a aucun mouvement enregistré.";
        _confirmationVisible = true;
    }

    private async Task ConfirmerSuppression()
    {
        _confirmationVisible = false;
        var resultat = await Api.SupprimerAsync($"api/matieres/{_idEnCours}");

        if (resultat.Succes)
        {
            Messages.Succes($"Matière « {_nomEnCours} » supprimée.");
            await ChargerAsync();
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }
}
