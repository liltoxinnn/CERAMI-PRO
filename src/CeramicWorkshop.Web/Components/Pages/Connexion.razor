@page "/connexion"
@layout LayoutConnexion
@inject ServiceAuthentification Authentification
@inject NavigationManager Navigation

<PageTitle>Connexion — CERAMIPRO</PageTitle>

<div class="carte-connexion">
    <div class="carte-connexion-entete">
        <span class="carte-connexion-logo" aria-hidden="true">🏺</span>
        <h1>CERAMIPRO</h1>
        <p>Gestion d'atelier de céramique et de décoration</p>
    </div>

    <EditForm Model="_requete" OnValidSubmit="SeConnecter" class="formulaire">
        <ResumeErreurs Message="@_messageErreur" Details="_details" />

        <div class="champ">
            <label for="nom-utilisateur">Nom d'utilisateur</label>
            <InputText id="nom-utilisateur" class="saisie" @bind-Value="_requete.NomUtilisateur"
                       autocomplete="username" placeholder="Exemple : admin" />
        </div>

        <div class="champ">
            <label for="mot-de-passe">Mot de passe</label>
            <InputText id="mot-de-passe" type="password" class="saisie" @bind-Value="_requete.MotDePasse"
                       autocomplete="current-password" />
        </div>

        <button type="submit" class="bouton bouton-principal bouton-large" disabled="@_enCours">
            @(_enCours ? "Connexion en cours…" : "Se connecter")
        </button>
    </EditForm>
</div>

@code {
    private readonly ConnexionRequete _requete = new();
    private string? _messageErreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();
    private bool _enCours;

    /// <summary>Page demandée avant la redirection vers la connexion.</summary>
    [SupplyParameterFromQuery(Name = "retour")]
    private string? Retour { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Une session encore valable évite de ressaisir les identifiants.
        if (await Authentification.RestaurerAsync())
        {
            Rediriger();
        }
    }

    private async Task SeConnecter()
    {
        _messageErreur = null;
        _details = Array.Empty<string>();

        if (string.IsNullOrWhiteSpace(_requete.NomUtilisateur) || string.IsNullOrWhiteSpace(_requete.MotDePasse))
        {
            _messageErreur = "Saisissez votre nom d'utilisateur et votre mot de passe.";
            return;
        }

        _enCours = true;

        try
        {
            var resultat = await Authentification.ConnexionAsync(_requete);

            if (!resultat.Succes)
            {
                _messageErreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            if (resultat.Valeur!.Utilisateur.DoitChangerMotDePasse)
            {
                Navigation.NavigateTo("mon-compte", replace: true);
                return;
            }

            Rediriger();
        }
        finally
        {
            _enCours = false;
        }
    }

    private void Rediriger()
    {
        var destination = string.IsNullOrWhiteSpace(Retour) ? "/" : Retour;
        Navigation.NavigateTo(destination, replace: true);
    }
}
