@page "/ventes"
@attribute [Authorize(Policy = PermissionCodes.VentesConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Ventes — CERAMIPRO</PageTitle>

<EntetePage Titre="Ventes" Introduction="Historique des ventes, factures émises et montants restant dus.">
    <Actions>
        <a class="bouton bouton-secondaire" href="factures">Factures</a>
        @if (PeutVendre)
        {
            <a class="bouton bouton-principal" href="ventes/nouvelle">+ Nouvelle vente</a>
        }
    </Actions>
</EntetePage>

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher un numéro ou un client…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="du">Du</label>
        <input id="du" type="date" class="saisie saisie-compacte" @onchange="FiltrerDu" />
    </div>
    <div class="champ">
        <label for="au">Au</label>
        <input id="au" type="date" class="saisie saisie-compacte" @onchange="FiltrerAu" />
    </div>

    <div class="champ-case">
        <input type="checkbox" id="impayees" checked="@_filtre.SeulementImpayees" @onchange="BasculerImpayees" />
        <label for="impayees">Seulement les ventes non réglées</label>
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des ventes…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucune vente ne correspond à ces critères." />
}
else
{
    <div class="bandeau-statistiques">
        <Statistique Valeur="@MontantFormatter.Formater(_page.Elements.Sum(v => v.Total))"
                     Libelle="chiffre d'affaires affiché" />
        <Statistique Valeur="@MontantFormatter.Formater(_page.Elements.Sum(v => v.Benefice))"
                     Libelle="bénéfice affiché" />
        <Statistique Valeur="@MontantFormatter.Formater(_page.Elements.Sum(v => v.Reste))"
                     Libelle="reste à encaisser"
                     Alerte="@(_page.Elements.Sum(v => v.Reste) > 0)" />
    </div>

    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Numéro</th><th>Date</th><th>Client</th><th>Facture</th>
                <th class="nombre">Total</th><th class="nombre">Payé</th><th class="nombre">Reste</th>
                <th>État</th><th class="colonne-actions">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var vente in _page.Elements)
            {
                <tr>
                    <td data-libelle="Numéro"><code>@vente.Numero</code></td>
                    <td data-libelle="Date">@MontantFormatter.FormaterDate(vente.Date.ToLocalTime())</td>
                    <td data-libelle="Client">@vente.ClientNom</td>
                    <td data-libelle="Facture">@(vente.FactureNumero ?? "—")</td>
                    <td class="nombre" data-libelle="Total">@MontantFormatter.Formater(vente.Total)</td>
                    <td class="nombre" data-libelle="Payé">@MontantFormatter.Formater(vente.Paye)</td>
                    <td class="nombre" data-libelle="Reste">
                        <span class="etiquette @(vente.Reste > 0 ? "etiquette-danger" : "etiquette-succes")">
                            @MontantFormatter.Formater(vente.Reste)
                        </span>
                    </td>
                    <td data-libelle="État">
                        <span class="etiquette @(vente.Statut == SaleStatus.Annulee
                            ? "etiquette-danger" : "etiquette-succes")">@vente.StatutLibelle</span>
                    </td>
                    <td class="colonne-actions" data-libelle="Actions">
                        <button type="button" class="bouton bouton-discret"
                                @onclick="() => OuvrirDetail(vente)">Détail</button>

                        @if (PeutEncaisser && vente.Reste > 0 && vente.Statut == SaleStatus.Confirmee)
                        {
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirPaiement(vente)">Encaisser</button>
                        }

                        @if (PeutAnnuler && vente.Statut == SaleStatus.Confirmee)
                        {
                            <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                    @onclick="() => OuvrirAnnulation(vente)">Annuler</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="VenteDto" Page="_page" Libelle="vente(s)" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_detailVisible" Large="true" Titre="@($"Vente {_numeroEnCours}")"
         OnFermer="() => _detailVisible = false">
    @if (_detail is not null)
    {
        <div class="detail-grille">
            <div><span class="champ-aide">Client</span><br /><strong>@_detail.ClientNom</strong></div>
            <div><span class="champ-aide">Date</span><br />
                @MontantFormatter.FormaterDateHeure(_detail.Date.ToLocalTime())</div>
            <div><span class="champ-aide">Facture</span><br />@(_detail.FactureNumero ?? "—")</div>
            <div><span class="champ-aide">Vendeur</span><br />@(_detail.Utilisateur ?? "—")</div>
        </div>

        <table class="lignes-document">
            <thead>
            <tr><th>Produit</th><th class="nombre">Quantité</th><th class="nombre">Prix unitaire</th>
                <th class="nombre">Remise</th><th class="nombre">Total</th></tr>
            </thead>
            <tbody>
            @foreach (var ligne in _detail.Lignes)
            {
                <tr>
                    <td data-libelle="Produit">@ligne.ProduitNom</td>
                    <td class="nombre" data-libelle="Quantité">
                        @MontantFormatter.FormaterQuantite(ligne.Quantite)</td>
                    <td class="nombre" data-libelle="Prix unitaire">
                        @MontantFormatter.Formater(ligne.PrixUnitaire)</td>
                    <td class="nombre" data-libelle="Remise">@MontantFormatter.Formater(ligne.Remise)</td>
                    <td class="nombre" data-libelle="Total">@MontantFormatter.Formater(ligne.Total)</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="totaux">
            <div class="totaux-ligne"><span>Sous-total</span>
                <span>@MontantFormatter.Formater(_detail.SousTotal)</span></div>
            <div class="totaux-ligne"><span>Remise</span>
                <span>− @MontantFormatter.Formater(_detail.Remise)</span></div>
            @if (_detail.Tva > 0)
            {
                <div class="totaux-ligne"><span>TVA</span><span>@MontantFormatter.Formater(_detail.Tva)</span></div>
            }
            <div class="totaux-ligne total"><span>Total</span>
                <span>@MontantFormatter.Formater(_detail.Total)</span></div>
            <div class="totaux-ligne"><span>Payé</span><span>@MontantFormatter.Formater(_detail.Paye)</span></div>
            <div class="totaux-ligne"><span>Reste à payer</span>
                <span>@MontantFormatter.Formater(_detail.Reste)</span></div>
            <div class="totaux-ligne"><span>Bénéfice</span>
                <span>@MontantFormatter.Formater(_detail.Benefice)</span></div>
        </div>
    }
</Fenetre>

<Fenetre Visible="_paiementVisible" Titre="@($"Encaisser — vente {_numeroEnCours}")"
         OnFermer="() => _paiementVisible = false">
    <ResumeErreurs Message="@_erreur" Details="_details" />

    <p class="carte-texte">Reste à payer : <strong>@MontantFormatter.Formater(_resteEnCours)</strong></p>

    <div class="grille-formulaire">
        <div class="champ">
            <label for="montant">Montant encaissé</label>
            <input id="montant" type="number" step="0.01" class="saisie" value="@_paiement.Montant"
                   @onchange="args => _paiement.Montant = Nombre(args)" />
        </div>
        <div class="champ">
            <label for="mode">Mode de règlement</label>
            <select id="mode" class="saisie" @onchange="args => _paiement.ModeReglementId = Entier(args)">
                <option value="0">— Choisir —</option>
                @foreach (var mode in _modes)
                {
                    <option value="@mode.Id">@mode.Nom</option>
                }
            </select>
        </div>
    </div>

    <div class="fenetre-actions">
        <button type="button" class="bouton bouton-secondaire"
                @onclick="() => _paiementVisible = false">Annuler</button>
        <button type="button" class="bouton bouton-principal" disabled="@_enregistrement" @onclick="Encaisser">
            @(_enregistrement ? "Enregistrement…" : "Enregistrer le paiement")
        </button>
    </div>
</Fenetre>

<Fenetre Visible="_annulationVisible" Titre="@($"Annuler la vente {_numeroEnCours}")"
         OnFermer="() => _annulationVisible = false">
    <ResumeErreurs Message="@_erreur" Details="_details" />

    <p class="carte-texte">
        Les produits seront remis en stock et la facture sera annulée.
        La vente reste consultable dans l'historique.
    </p>

    <div class="champ">
        <label for="motif">Motif de l'annulation</label>
        <input id="motif" class="saisie" @bind="_motif" />
    </div>

    <div class="fenetre-actions">
        <button type="button" class="bouton bouton-secondaire"
                @onclick="() => _annulationVisible = false">Revenir</button>
        <button type="button" class="bouton bouton-danger" disabled="@_enregistrement" @onclick="Annuler">
            @(_enregistrement ? "Annulation…" : "Confirmer l'annulation")
        </button>
    </div>
</Fenetre>

@code {
    private PagedResult<VenteDto>? _page;
    private VenteDto? _detail;
    private List<ModeReglementDto> _modes = new();

    private FiltreVentesRequete _filtre = new();
    private PaiementRequete _paiement = new();

    private bool _chargement = true;
    private bool _detailVisible, _paiementVisible, _annulationVisible, _enregistrement;

    private int _idEnCours;
    private decimal _resteEnCours;
    private string _numeroEnCours = string.Empty;
    private string _motif = string.Empty;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutVendre => Authentification.Session.PossedeDroit(PermissionCodes.VentesCreer);
    private bool PeutAnnuler => Authentification.Session.PossedeDroit(PermissionCodes.VentesAnnuler);
    private bool PeutEncaisser => Authentification.Session.PossedeDroit(PermissionCodes.PaiementsEnregistrer);

    private static decimal Nombre(ChangeEventArgs args)
        => decimal.TryParse(args.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var valeur)
            ? valeur
            : 0m;

    private static int Entier(ChangeEventArgs args)
        => int.TryParse(args.Value?.ToString(), out var valeur) ? valeur : 0;

    protected override async Task OnInitializedAsync()
    {
        var modes = await Api.ObtenirAsync<List<ModeReglementDto>>("api/modes-reglement");
        if (modes.Succes && modes.Valeur is not null) _modes = modes.Valeur;

        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/ventes?page={_filtre.Page}&taillePage={_filtre.TaillePage}" +
                     $"&seulementImpayees={_filtre.SeulementImpayees}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        if (_filtre.Du is not null) chemin += $"&du={_filtre.Du:yyyy-MM-dd}";
        if (_filtre.Au is not null) chemin += $"&au={_filtre.Au:yyyy-MM-dd}";

        var resultat = await Api.ObtenirAsync<PagedResult<VenteDto>>(chemin);
        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerDu(ChangeEventArgs args)
    {
        _filtre.Du = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerAu(ChangeEventArgs args)
    {
        _filtre.Au = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task BasculerImpayees(ChangeEventArgs args)
    {
        _filtre.SeulementImpayees = args.Value is true;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private async Task OuvrirDetail(VenteDto vente)
    {
        var resultat = await Api.ObtenirAsync<VenteDto>($"api/ventes/{vente.Id}");

        if (!resultat.Succes)
        {
            Messages.Erreur(resultat.Message);
            return;
        }

        _detail = resultat.Valeur;
        _numeroEnCours = vente.Numero;
        _detailVisible = true;
    }

    private void OuvrirPaiement(VenteDto vente)
    {
        _idEnCours = vente.Id;
        _numeroEnCours = vente.Numero;
        _resteEnCours = vente.Reste;
        _paiement = new PaiementRequete
        {
            VenteId = vente.Id, ClientId = vente.ClientId, Montant = vente.Reste
        };
        _erreur = null;
        _details = Array.Empty<string>();
        _paiementVisible = true;
    }

    private void OuvrirAnnulation(VenteDto vente)
    {
        _idEnCours = vente.Id;
        _numeroEnCours = vente.Numero;
        _motif = string.Empty;
        _erreur = null;
        _details = Array.Empty<string>();
        _annulationVisible = true;
    }

    private async Task Encaisser()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<PaiementDto>("api/paiements", _paiement);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Paiement de {MontantFormatter.Formater(_paiement.Montant)} enregistré.");
            _paiementVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task Annuler()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<VenteDto>(
                $"api/ventes/{_idEnCours}/annulation", new { Motif = _motif });

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Vente {_numeroEnCours} annulée : produits remis en stock.");
            _annulationVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }
}
