@page "/paiements"
@attribute [Authorize(Policy = PermissionCodes.PaiementsConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification

<PageTitle>Paiements — CERAMIPRO</PageTitle>

<EntetePage Titre="Paiements" Introduction="Tous les encaissements enregistrés, acomptes compris." />

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher un numéro, un client, une référence…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="du">Du</label>
        <input id="du" type="date" class="saisie saisie-compacte" @onchange="FiltrerDu" />
    </div>
    <div class="champ">
        <label for="au">Au</label>
        <input id="au" type="date" class="saisie saisie-compacte" @onchange="FiltrerAu" />
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des paiements…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucun paiement ne correspond à ces critères." />
}
else
{
    <div class="bandeau-statistiques">
        <Statistique Valeur="@MontantFormatter.Formater(_page.Elements.Sum(p => p.Montant))"
                     Libelle="total encaissé sur cette page" />
        <Statistique Valeur="@_page.Total.ToString()" Libelle="paiements enregistrés" />
    </div>

    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Numéro</th><th>Date</th><th>Client</th><th>Document</th>
                <th class="nombre">Montant</th><th>Mode</th><th>Référence</th><th>Encaissé par</th>
                @if (PeutAnnuler) { <th class="colonne-actions">Actions</th> }
            </tr>
            </thead>
            <tbody>
            @foreach (var paiement in _page.Elements)
            {
                <tr>
                    <td data-libelle="Numéro"><code>@paiement.Numero</code></td>
                    <td data-libelle="Date">@MontantFormatter.FormaterDate(paiement.Date.ToLocalTime())</td>
                    <td data-libelle="Client">@(paiement.ClientNom ?? "Client de passage")</td>
                    <td data-libelle="Document">
                        @(paiement.VenteNumero ?? paiement.CommandeNumero ?? paiement.FactureNumero ?? "—")
                        @if (paiement.Acompte)
                        {
                            <span class="etiquette etiquette-info">Acompte</span>
                        }
                    </td>
                    <td class="nombre" data-libelle="Montant">
                        <strong>@MontantFormatter.Formater(paiement.Montant)</strong></td>
                    <td data-libelle="Mode">@paiement.ModeReglement</td>
                    <td data-libelle="Référence">@(paiement.Reference ?? "—")</td>
                    <td data-libelle="Encaissé par">@(paiement.Utilisateur ?? "—")</td>
                    @if (PeutAnnuler)
                    {
                        <td class="colonne-actions" data-libelle="Actions">
                            <button type="button" class="bouton bouton-discret bouton-discret-danger"
                                    @onclick="() => OuvrirAnnulation(paiement)">Annuler</button>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="PaiementDto" Page="_page" Libelle="paiement(s)" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_annulationVisible" Titre="@($"Annuler le paiement {_numeroEnCours}")"
         OnFermer="() => _annulationVisible = false">
    <ResumeErreurs Message="@_erreur" Details="_details" />

    <p class="carte-texte">
        Le paiement reste consultable dans l'historique : il est marqué comme annulé et les soldes
        des documents concernés sont corrigés.
    </p>

    <div class="champ">
        <label for="motif">Motif de l'annulation</label>
        <input id="motif" class="saisie" @bind="_motif" />
    </div>

    <div class="fenetre-actions">
        <button type="button" class="bouton bouton-secondaire"
                @onclick="() => _annulationVisible = false">Revenir</button>
        <button type="button" class="bouton bouton-danger" disabled="@_enregistrement" @onclick="Annuler">
            @(_enregistrement ? "Annulation…" : "Confirmer l'annulation")
        </button>
    </div>
</Fenetre>

@code {
    private PagedResult<PaiementDto>? _page;
    private FiltrePaiementsRequete _filtre = new();

    private bool _chargement = true;
    private bool _annulationVisible, _enregistrement;
    private int _idEnCours;
    private string _numeroEnCours = string.Empty;
    private string _motif = string.Empty;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutAnnuler => Authentification.Session.PossedeDroit(PermissionCodes.PaiementsAnnuler);

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/paiements?page={_filtre.Page}&taillePage={_filtre.TaillePage}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        if (_filtre.Du is not null) chemin += $"&du={_filtre.Du:yyyy-MM-dd}";
        if (_filtre.Au is not null) chemin += $"&au={_filtre.Au:yyyy-MM-dd}";

        var resultat = await Api.ObtenirAsync<PagedResult<PaiementDto>>(chemin);
        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerDu(ChangeEventArgs args)
    {
        _filtre.Du = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerAu(ChangeEventArgs args)
    {
        _filtre.Au = DateTime.TryParse(args.Value?.ToString(), out var date) ? date : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private void OuvrirAnnulation(PaiementDto paiement)
    {
        _idEnCours = paiement.Id;
        _numeroEnCours = paiement.Numero;
        _motif = string.Empty;
        _erreur = null;
        _details = Array.Empty<string>();
        _annulationVisible = true;
    }

    private async Task Annuler()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<object>(
                $"api/paiements/{_idEnCours}/annulation", new { Motif = _motif });

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Paiement {_numeroEnCours} annulé.");
            _annulationVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }
}
