@page "/commandes"
@attribute [Authorize(Policy = PermissionCodes.CommandesConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages
@inject ServiceAuthentification Authentification
@inject AdresseServeur Serveur

<PageTitle>Commandes personnalisées — CERAMIPRO</PageTitle>

<EntetePage Titre="Commandes personnalisées"
            Introduction="Pièces sur mesure : dimensions, couleurs, croquis, acompte et date limite.">
    <Actions>
        @if (PeutGerer)
        {
            <button type="button" class="bouton bouton-principal" @onclick="OuvrirCreation">+ Nouvelle commande</button>
        }
    </Actions>
</EntetePage>

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher un numéro, un titre, un client…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="statut">État</label>
        <select id="statut" class="saisie saisie-compacte" @onchange="FiltrerStatut">
            <option value="">Tous</option>
            @foreach (var (valeur, libelle) in EnumExtensions.Libelles<CustomOrderStatus>())
            {
                <option value="@valeur">@libelle</option>
            }
        </select>
    </div>

    <div class="champ-case">
        <input type="checkbox" id="retard" checked="@_filtre.SeulementEnRetard" @onchange="BasculerRetard" />
        <label for="retard">En retard</label>
    </div>

    <div class="champ-case">
        <input type="checkbox" id="echeance" checked="@_filtre.SeulementProchesEcheance"
               @onchange="BasculerEcheance" />
        <label for="echeance">Échéance proche</label>
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des commandes…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucune commande personnalisée ne correspond à ces critères." />
}
else
{
    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Numéro</th><th>Client</th><th>Pièce demandée</th><th>État</th>
                <th class="nombre">Total</th><th class="nombre">Payé</th><th class="nombre">Reste</th>
                <th>Date limite</th><th class="colonne-actions">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var commande in _page.Elements)
            {
                <tr>
                    <td data-libelle="Numéro"><code>@commande.Numero</code></td>
                    <td data-libelle="Client">
                        @commande.ClientNom
                        @if (!string.IsNullOrWhiteSpace(commande.ClientTelephone))
                        {
                            <br /><span class="champ-aide">@commande.ClientTelephone</span>
                        }
                    </td>
                    <td data-libelle="Pièce demandée">@commande.Titre</td>
                    <td data-libelle="État">
                        <span class="etiquette @ClasseStatut(commande.Statut)">@commande.StatutLibelle</span>
                    </td>
                    <td class="nombre" data-libelle="Total">@MontantFormatter.Formater(commande.Total)</td>
                    <td class="nombre" data-libelle="Payé">@MontantFormatter.Formater(commande.Paye)</td>
                    <td class="nombre" data-libelle="Reste">@MontantFormatter.Formater(commande.Reste)</td>
                    <td data-libelle="Date limite">
                        @MontantFormatter.FormaterDate(commande.DateLimite.ToLocalTime())
                        @if (commande.EnRetard)
                        {
                            <br /><span class="etiquette etiquette-danger">En retard</span>
                        }
                        else if (commande.JoursRestants <= 3 && commande.Statut != CustomOrderStatus.Livre
                                 && commande.Statut != CustomOrderStatus.Annule)
                        {
                            <br /><span class="etiquette etiquette-attention">
                                @commande.JoursRestants jour(s)
                            </span>
                        }
                    </td>
                    <td class="colonne-actions" data-libelle="Actions">
                        <button type="button" class="bouton bouton-discret"
                                @onclick="() => OuvrirDetail(commande)">Détail</button>

                        @if (PeutGerer && commande.Statut != CustomOrderStatus.Livre
                             && commande.Statut != CustomOrderStatus.Annule)
                        {
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirEtape(commande)">Étape suivante</button>
                        }

                        @if (PeutEncaisser && commande.Reste > 0 && commande.Statut != CustomOrderStatus.Annule)
                        {
                            <button type="button" class="bouton bouton-discret"
                                    @onclick="() => OuvrirPaiement(commande)">Encaisser</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="CommandeDto" Page="_page" Libelle="commande(s)" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_formulaireVisible" Large="true"
         Titre="@(_creation ? "Nouvelle commande personnalisée" : $"Modifier {_numeroEnCours}")"
         OnFermer="() => _formulaireVisible = false">
    <EditForm Model="_formulaire" OnValidSubmit="Enregistrer" class="formulaire">
        <ResumeErreurs Message="@_erreur" Details="_details" />

        <div class="grille-formulaire">
            <div class="champ">
                <label for="client">Client</label>
                <InputSelect id="client" class="saisie" @bind-Value="_formulaire.ClientId" disabled="@(!_creation)">
                    <option value="0">— Choisir —</option>
                    @foreach (var client in _clients)
                    {
                        <option value="@client.Id">@client.Nom</option>
                    }
                </InputSelect>
            </div>
            <div class="champ">
                <label for="titre">Pièce demandée</label>
                <InputText id="titre" class="saisie" @bind-Value="_formulaire.Titre" />
            </div>
            <div class="champ">
                <label for="largeur">Largeur (cm)</label>
                <InputNumber id="largeur" class="saisie" @bind-Value="_formulaire.Largeur" />
            </div>
            <div class="champ">
                <label for="hauteur">Hauteur (cm)</label>
                <InputNumber id="hauteur" class="saisie" @bind-Value="_formulaire.Hauteur" />
            </div>
            <div class="champ">
                <label for="profondeur">Profondeur (cm)</label>
                <InputNumber id="profondeur" class="saisie" @bind-Value="_formulaire.Profondeur" />
            </div>
            <div class="champ">
                <label for="couleurs">Couleurs</label>
                <InputText id="couleurs" class="saisie" @bind-Value="_formulaire.Couleurs" />
            </div>
            <div class="champ">
                <label for="materiaux">Matériaux</label>
                <InputText id="materiaux" class="saisie" @bind-Value="_formulaire.Materiaux" />
            </div>
            <div class="champ">
                <label for="quantite">Quantité</label>
                <InputNumber id="quantite" class="saisie" @bind-Value="_formulaire.Quantite" />
            </div>
            <div class="champ">
                <label for="prix">Prix unitaire</label>
                <InputNumber id="prix" class="saisie" @bind-Value="_formulaire.PrixUnitaire" />
            </div>
            <div class="champ">
                <label for="remise">Remise</label>
                <InputNumber id="remise" class="saisie" @bind-Value="_formulaire.Remise" />
            </div>
            <div class="champ">
                <label for="limite">Date limite</label>
                <InputDate id="limite" class="saisie" @bind-Value="_formulaire.DateLimite" />
            </div>
            <div class="champ">
                <label for="employe">Employé responsable</label>
                <InputSelect id="employe" class="saisie" @bind-Value="_formulaire.EmployeId">
                    <option value="">Non assigné</option>
                    @foreach (var employe in _employes)
                    {
                        <option value="@employe.Id">@employe.NomComplet</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="champ">
            <label for="description">Description détaillée</label>
            <InputTextArea id="description" class="saisie saisie-multiligne" rows="3"
                           @bind-Value="_formulaire.Description" />
        </div>

        <div class="totaux">
            <div class="totaux-ligne total"><span>Total</span>
                <span>@MontantFormatter.Formater(Total)</span></div>
        </div>

        <div class="fenetre-actions">
            <button type="button" class="bouton bouton-secondaire"
                    @onclick="() => _formulaireVisible = false">Annuler</button>
            <button type="submit" class="bouton bouton-principal" disabled="@_enregistrement">
                @(_enregistrement ? "Enregistrement…" : "Enregistrer")
            </button>
        </div>
    </EditForm>
</Fenetre>

<Fenetre Visible="_detailVisible" Large="true" Titre="@($"Commande {_numeroEnCours}")"
         OnFermer="() => _detailVisible = false">
    @if (_detail is not null)
    {
        <div class="detail-grille">
            <div><span class="champ-aide">Client</span><br /><strong>@_detail.ClientNom</strong></div>
            <div><span class="champ-aide">Pièce</span><br />@_detail.Titre</div>
            <div><span class="champ-aide">Dimensions</span><br />@Dimensions(_detail)</div>
            <div><span class="champ-aide">Couleurs</span><br />@(_detail.Couleurs ?? "—")</div>
            <div><span class="champ-aide">Matériaux</span><br />@(_detail.Materiaux ?? "—")</div>
            <div><span class="champ-aide">Quantité</span><br />
                @MontantFormatter.FormaterQuantite(_detail.Quantite)</div>
            <div><span class="champ-aide">Prix</span><br />@MontantFormatter.Formater(_detail.Total)</div>
            <div><span class="champ-aide">Acompte versé</span><br />@MontantFormatter.Formater(_detail.Paye)</div>
            <div><span class="champ-aide">Reste</span><br />
                <strong>@MontantFormatter.Formater(_detail.Reste)</strong></div>
            <div><span class="champ-aide">Date limite</span><br />
                @MontantFormatter.FormaterDate(_detail.DateLimite.ToLocalTime())</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_detail.Description))
        {
            <p class="carte-texte">@_detail.Description</p>
        }

        <h3>Photos et croquis</h3>
        @if (PeutGerer)
        {
            <div class="champ">
                <label for="type-photo">Type de photo</label>
                <select id="type-photo" class="saisie" @onchange="ChoisirTypePhoto">
                    @foreach (var (valeur, libelle) in EnumExtensions.Libelles<CustomOrderImageKind>())
                    {
                        <option value="@valeur">@libelle</option>
                    }
                </select>
            </div>
            <TeleversementFichier Libelle="Ajouter une photo" TypesAcceptes="image/jpeg,image/png,image/webp"
                                  OnDepose="AjouterPhoto" />
        }

        @if (_detail.Photos.Count == 0)
        {
            <EtatVide Message="Aucune photo pour cette commande." />
        }
        else
        {
            <div class="galerie">
                @foreach (var photo in _detail.Photos)
                {
                    <figure class="galerie-element">
                        <img src="@Serveur.Fichier(photo.Chemin)" alt="@(photo.Legende ?? photo.TypeLibelle)" />
                        <figcaption>@photo.TypeLibelle</figcaption>
                    </figure>
                }
            </div>
        }

        <h3>Notes</h3>
        @if (PeutGerer)
        {
            <div class="champ">
                <label for="note">Ajouter une note</label>
                <textarea id="note" class="saisie saisie-multiligne" rows="2" @bind="_nouvelleNote"></textarea>
            </div>
            <button type="button" class="bouton bouton-secondaire" @onclick="AjouterNote">Enregistrer la note</button>
        }

        @if (_detail.NotesHistorique.Count > 0)
        {
            <ul class="chronologie">
                @foreach (var note in _detail.NotesHistorique)
                {
                    <li>
                        @note.Contenu
                        <span class="champ-aide">
                            @MontantFormatter.FormaterDateHeure(note.Date.ToLocalTime())
                            @if (note.Auteur is not null)
                            {
                                <text> · @note.Auteur</text>
                            }
                        </span>
                    </li>
                }
            </ul>
        }
    }
</Fenetre>

<Fenetre Visible="_etapeVisible" Titre="@($"Faire avancer {_numeroEnCours}")"
         OnFermer="() => _etapeVisible = false">
    <ResumeErreurs Message="@_erreur" Details="_details" />

    <div class="champ">
        <label for="nouvelle-etape">Nouvelle étape</label>
        <select id="nouvelle-etape" class="saisie" @onchange="ChoisirEtape">
            @foreach (var etape in _etapesPossibles)
            {
                <option value="@etape" selected="@(etape == _nouvelleEtape)">@etape.Libelle()</option>
            }
        </select>
    </div>

    <div class="fenetre-actions">
        <button type="button" class="bouton bouton-secondaire" @onclick="() => _etapeVisible = false">Annuler</button>
        <button type="button" class="bouton bouton-principal" disabled="@_enregistrement" @onclick="ChangerEtape">
            @(_enregistrement ? "Enregistrement…" : "Enregistrer")
        </button>
    </div>
</Fenetre>

<Fenetre Visible="_paiementVisible" Titre="@($"Encaisser — {_numeroEnCours}")"
         OnFermer="() => _paiementVisible = false">
    <ResumeErreurs Message="@_erreur" Details="_details" />

    <p class="carte-texte">Reste à payer : <strong>@MontantFormatter.Formater(_resteEnCours)</strong></p>

    <div class="grille-formulaire">
        <div class="champ">
            <label for="montant">Montant encaissé</label>
            <input id="montant" type="number" step="0.01" class="saisie" value="@_paiement.Montant"
                   @onchange="args => _paiement.Montant = Nombre(args)" />
        </div>
        <div class="champ">
            <label for="mode">Mode de règlement</label>
            <select id="mode" class="saisie" @onchange="args => _paiement.ModeReglementId = Entier(args)">
                <option value="0">— Choisir —</option>
                @foreach (var mode in _modes)
                {
                    <option value="@mode.Id">@mode.Nom</option>
                }
            </select>
        </div>
    </div>

    <div class="champ-case">
        <input type="checkbox" id="acompte" checked="@_paiement.Acompte"
               @onchange="args => _paiement.Acompte = args.Value is true" />
        <label for="acompte">Il s'agit d'un acompte</label>
    </div>

    <div class="fenetre-actions">
        <button type="button" class="bouton bouton-secondaire"
                @onclick="() => _paiementVisible = false">Annuler</button>
        <button type="button" class="bouton bouton-principal" disabled="@_enregistrement" @onclick="Encaisser">
            @(_enregistrement ? "Enregistrement…" : "Enregistrer le paiement")
        </button>
    </div>
</Fenetre>

@code {
    private PagedResult<CommandeDto>? _page;
    private CommandeDto? _detail;
    private List<ClientDto> _clients = new();
    private List<UtilisateurDto> _employes = new();
    private List<ModeReglementDto> _modes = new();
    private List<CustomOrderStatus> _etapesPossibles = new();

    private FiltreCommandesRequete _filtre = new();
    private CommandeRequete _formulaire = new();
    private PaiementRequete _paiement = new();
    private CustomOrderStatus _nouvelleEtape;
    private CustomOrderImageKind _typePhoto = CustomOrderImageKind.Reference;

    private bool _chargement = true;
    private bool _formulaireVisible, _detailVisible, _etapeVisible, _paiementVisible;
    private bool _creation, _enregistrement;

    private int _idEnCours;
    private decimal _resteEnCours;
    private string _numeroEnCours = string.Empty;
    private string _nouvelleNote = string.Empty;
    private string? _erreur;
    private IReadOnlyList<string> _details = Array.Empty<string>();

    private bool PeutGerer => Authentification.Session.PossedeDroit(PermissionCodes.CommandesGerer);
    private bool PeutEncaisser => Authentification.Session.PossedeDroit(PermissionCodes.PaiementsEnregistrer);

    private decimal Total => Math.Round(_formulaire.Quantite * _formulaire.PrixUnitaire - _formulaire.Remise, 2);

    private static readonly CustomOrderStatus[] Sequence =
    {
        CustomOrderStatus.Commande, CustomOrderStatus.Conception, CustomOrderStatus.ValidationClient,
        CustomOrderStatus.Production, CustomOrderStatus.Cuisson, CustomOrderStatus.Decoration,
        CustomOrderStatus.ControleQualite, CustomOrderStatus.Pret, CustomOrderStatus.Livre
    };

    private static string ClasseStatut(CustomOrderStatus statut) => statut switch
    {
        CustomOrderStatus.Livre => "etiquette-succes",
        CustomOrderStatus.Annule => "etiquette-danger",
        CustomOrderStatus.Commande => "etiquette-neutre",
        _ => "etiquette-attention"
    };

    private static string Dimensions(CommandeDto c)
    {
        var parties = new List<string>();
        if (c.Largeur is not null) parties.Add($"{c.Largeur:0.##}");
        if (c.Hauteur is not null) parties.Add($"{c.Hauteur:0.##}");
        if (c.Profondeur is not null) parties.Add($"{c.Profondeur:0.##}");
        return parties.Count == 0 ? "—" : string.Join(" × ", parties) + " cm";
    }

    private static decimal Nombre(ChangeEventArgs args)
        => decimal.TryParse(args.Value?.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var valeur)
            ? valeur
            : 0m;

    private static int Entier(ChangeEventArgs args)
        => int.TryParse(args.Value?.ToString(), out var valeur) ? valeur : 0;

    protected override async Task OnInitializedAsync()
    {
        var clients = await Api.ObtenirAsync<PagedResult<ClientDto>>("api/clients?taillePage=300");
        if (clients.Succes && clients.Valeur is not null) _clients = clients.Valeur.Elements.ToList();

        var employes = await Api.ObtenirAsync<PagedResult<UtilisateurDto>>("api/utilisateurs?taillePage=100");
        if (employes.Succes && employes.Valeur is not null)
            _employes = employes.Valeur.Elements.Where(u => u.Actif).ToList();

        var modes = await Api.ObtenirAsync<List<ModeReglementDto>>("api/modes-reglement");
        if (modes.Succes && modes.Valeur is not null) _modes = modes.Valeur;

        await ChargerAsync();
    }

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/commandes?page={_filtre.Page}&taillePage={_filtre.TaillePage}" +
                     $"&seulementEnRetard={_filtre.SeulementEnRetard}" +
                     $"&seulementProchesEcheance={_filtre.SeulementProchesEcheance}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        if (_filtre.Statut is not null) chemin += $"&statut={_filtre.Statut}";

        var resultat = await Api.ObtenirAsync<PagedResult<CommandeDto>>(chemin);
        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerStatut(ChangeEventArgs args)
    {
        _filtre.Statut = Enum.TryParse<CustomOrderStatus>(args.Value?.ToString(), out var statut) ? statut : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task BasculerRetard(ChangeEventArgs args)
    {
        _filtre.SeulementEnRetard = args.Value is true;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task BasculerEcheance(ChangeEventArgs args)
    {
        _filtre.SeulementProchesEcheance = args.Value is true;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private void OuvrirCreation()
    {
        _creation = true;
        _idEnCours = 0;
        _formulaire = new CommandeRequete
        {
            Quantite = 1m,
            DateLimite = DateTime.Today.AddDays(15)
        };
        _erreur = null;
        _details = Array.Empty<string>();
        _formulaireVisible = true;
    }

    private async Task<CommandeDto?> ChargerDetailAsync(int id)
    {
        var resultat = await Api.ObtenirAsync<CommandeDto>($"api/commandes/{id}");

        if (!resultat.Succes)
        {
            Messages.Erreur(resultat.Message);
            return null;
        }

        return resultat.Valeur;
    }

    private async Task OuvrirDetail(CommandeDto commande)
    {
        _detail = await ChargerDetailAsync(commande.Id);
        if (_detail is null) return;

        _idEnCours = commande.Id;
        _numeroEnCours = commande.Numero;
        _nouvelleNote = string.Empty;
        _detailVisible = true;
    }

    private void OuvrirEtape(CommandeDto commande)
    {
        _idEnCours = commande.Id;
        _numeroEnCours = commande.Numero;
        var position = Array.IndexOf(Sequence, commande.Statut);
        _etapesPossibles = Sequence.Skip(position + 1).ToList();
        _nouvelleEtape = _etapesPossibles.FirstOrDefault();
        _erreur = null;
        _details = Array.Empty<string>();
        _etapeVisible = true;
    }

    private void OuvrirPaiement(CommandeDto commande)
    {
        _idEnCours = commande.Id;
        _numeroEnCours = commande.Numero;
        _resteEnCours = commande.Reste;
        _paiement = new PaiementRequete
        {
            CommandeId = commande.Id,
            ClientId = commande.ClientId,
            Montant = commande.Reste,
            Acompte = commande.Paye == 0
        };
        _erreur = null;
        _details = Array.Empty<string>();
        _paiementVisible = true;
    }

    private void ChoisirEtape(ChangeEventArgs args)
    {
        if (Enum.TryParse<CustomOrderStatus>(args.Value?.ToString(), out var etape))
        {
            _nouvelleEtape = etape;
        }
    }

    private void ChoisirTypePhoto(ChangeEventArgs args)
    {
        if (Enum.TryParse<CustomOrderImageKind>(args.Value?.ToString(), out var type))
        {
            _typePhoto = type;
        }
    }

    private async Task Enregistrer()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = _creation
                ? await Api.PosterAsync<CommandeDto>("api/commandes", _formulaire)
                : await Api.MettreAJourAsync<CommandeDto>($"api/commandes/{_idEnCours}", _formulaire);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Commande {resultat.Valeur!.Numero} enregistrée.");
            _formulaireVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task ChangerEtape()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<CommandeDto>(
                $"api/commandes/{_idEnCours}/statut", new { Statut = _nouvelleEtape });

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Commande {_numeroEnCours} : {resultat.Valeur!.StatutLibelle}.");
            _etapeVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task Encaisser()
    {
        _erreur = null;
        _details = Array.Empty<string>();
        _enregistrement = true;

        try
        {
            var resultat = await Api.PosterAsync<PaiementDto>("api/paiements", _paiement);

            if (!resultat.Succes)
            {
                _erreur = resultat.Message;
                _details = resultat.Details;
                return;
            }

            Messages.Succes($"Paiement de {MontantFormatter.Formater(_paiement.Montant)} enregistré.");
            _paiementVisible = false;
            await ChargerAsync();
        }
        finally
        {
            _enregistrement = false;
        }
    }

    private async Task AjouterPhoto(string chemin)
    {
        var resultat = await Api.PosterAsync<CommandeDto>($"api/commandes/{_idEnCours}/photos",
            new PhotoCommandeRequete { Chemin = chemin, Type = _typePhoto });

        if (resultat.Succes)
        {
            Messages.Succes("Photo ajoutée.");
            _detail = resultat.Valeur;
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }

    private async Task AjouterNote()
    {
        if (string.IsNullOrWhiteSpace(_nouvelleNote)) return;

        var resultat = await Api.PosterAsync<CommandeDto>($"api/commandes/{_idEnCours}/notes",
            new NoteRequete { Contenu = _nouvelleNote });

        if (resultat.Succes)
        {
            Messages.Succes("Note enregistrée.");
            _nouvelleNote = string.Empty;
            _detail = resultat.Valeur;
        }
        else
        {
            Messages.Erreur(resultat.Message);
        }
    }
}
