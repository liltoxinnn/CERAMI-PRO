@page "/factures"
@attribute [Authorize(Policy = PermissionCodes.FacturesConsulter)]
@inject ClientApi Api
@inject ServiceMessages Messages

<PageTitle>Factures — CERAMIPRO</PageTitle>

<EntetePage Titre="Factures" Introduction="Factures émises pour les ventes et les commandes personnalisées.">
    <Actions>
        <a class="bouton bouton-secondaire" href="ventes">Ventes</a>
    </Actions>
</EntetePage>

<div class="filtres">
    <ChampRecherche Valeur="@_filtre.Recherche" Placeholder="Rechercher un numéro ou un client…"
                    OnRechercher="Rechercher" />

    <div class="champ">
        <label for="statut">État</label>
        <select id="statut" class="saisie saisie-compacte" @onchange="FiltrerStatut">
            <option value="">Tous</option>
            @foreach (var (valeur, libelle) in EnumExtensions.Libelles<InvoiceStatus>())
            {
                <option value="@valeur">@libelle</option>
            }
        </select>
    </div>

    <div class="champ-case">
        <input type="checkbox" id="impayees" checked="@_filtre.SeulementImpayees" @onchange="BasculerImpayees" />
        <label for="impayees">Seulement les factures non réglées</label>
    </div>
</div>

@if (_chargement)
{
    <Chargement Message="Chargement des factures…" />
}
else if (_page is null || _page.Elements.Count == 0)
{
    <EtatVide Message="Aucune facture ne correspond à ces critères." />
}
else
{
    <div class="tableau-defilant">
        <table class="tableau">
            <thead>
            <tr>
                <th>Numéro</th><th>Date</th><th>Client</th><th>Document</th>
                <th class="nombre">Total</th><th class="nombre">Payé</th><th class="nombre">Reste</th>
                <th>État</th><th class="colonne-actions">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var facture in _page.Elements)
            {
                <tr>
                    <td data-libelle="Numéro"><code>@facture.Numero</code></td>
                    <td data-libelle="Date">@MontantFormatter.FormaterDate(facture.DateEmission.ToLocalTime())</td>
                    <td data-libelle="Client">@facture.ClientNom</td>
                    <td data-libelle="Document">@(facture.VenteNumero ?? facture.CommandeNumero ?? "—")</td>
                    <td class="nombre" data-libelle="Total">@MontantFormatter.Formater(facture.Total)</td>
                    <td class="nombre" data-libelle="Payé">@MontantFormatter.Formater(facture.Paye)</td>
                    <td class="nombre" data-libelle="Reste">@MontantFormatter.Formater(facture.Reste)</td>
                    <td data-libelle="État">
                        <span class="etiquette @ClasseStatut(facture.Statut)">@facture.StatutLibelle</span>
                    </td>
                    <td class="colonne-actions" data-libelle="Actions">
                        <button type="button" class="bouton bouton-discret"
                                @onclick="() => OuvrirDetail(facture)">Voir</button>
                        <a class="bouton bouton-discret" href="factures/@facture.Id/impression" target="_blank">
                            Imprimer
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pagination TElement="FactureDto" Page="_page" Libelle="facture(s)" OnChangerPage="ChangerPage" />
}

<Fenetre Visible="_detailVisible" Large="true" Titre="@($"Facture {_numeroEnCours}")"
         OnFermer="() => _detailVisible = false">
    @if (_detail is not null)
    {
        <div class="detail-grille">
            <div><span class="champ-aide">Client</span><br /><strong>@_detail.ClientNom</strong></div>
            <div><span class="champ-aide">Date d'émission</span><br />
                @MontantFormatter.FormaterDate(_detail.DateEmission.ToLocalTime())</div>
            <div><span class="champ-aide">Échéance</span><br />
                @(_detail.DateEcheance is null
                    ? "—" : MontantFormatter.FormaterDate(_detail.DateEcheance.Value.ToLocalTime()))</div>
            <div><span class="champ-aide">État</span><br />@_detail.StatutLibelle</div>
        </div>

        <table class="lignes-document">
            <thead>
            <tr><th>Désignation</th><th class="nombre">Quantité</th><th class="nombre">Prix unitaire</th>
                <th class="nombre">Remise</th><th class="nombre">Total</th></tr>
            </thead>
            <tbody>
            @foreach (var ligne in _detail.Lignes)
            {
                <tr>
                    <td data-libelle="Désignation">@ligne.Description</td>
                    <td class="nombre" data-libelle="Quantité">
                        @MontantFormatter.FormaterQuantite(ligne.Quantite)</td>
                    <td class="nombre" data-libelle="Prix unitaire">
                        @MontantFormatter.Formater(ligne.PrixUnitaire)</td>
                    <td class="nombre" data-libelle="Remise">@MontantFormatter.Formater(ligne.Remise)</td>
                    <td class="nombre" data-libelle="Total">@MontantFormatter.Formater(ligne.Total)</td>
                </tr>
            }
            </tbody>
        </table>

        <div class="totaux">
            <div class="totaux-ligne"><span>Sous-total</span>
                <span>@MontantFormatter.Formater(_detail.SousTotal)</span></div>
            <div class="totaux-ligne"><span>Remise</span>
                <span>− @MontantFormatter.Formater(_detail.Remise)</span></div>
            @if (_detail.Tva > 0)
            {
                <div class="totaux-ligne"><span>TVA (@_detail.TauxTva.ToString("0.##") %)</span>
                    <span>@MontantFormatter.Formater(_detail.Tva)</span></div>
            }
            <div class="totaux-ligne total"><span>Total</span>
                <span>@MontantFormatter.Formater(_detail.Total)</span></div>
            <div class="totaux-ligne"><span>Payé</span><span>@MontantFormatter.Formater(_detail.Paye)</span></div>
            <div class="totaux-ligne"><span>Reste à payer</span>
                <span>@MontantFormatter.Formater(_detail.Reste)</span></div>
        </div>

        <div class="fenetre-actions">
            <a class="bouton bouton-principal" href="factures/@_detail.Id/impression" target="_blank">
                Ouvrir la facture imprimable
            </a>
        </div>
    }
</Fenetre>

@code {
    private PagedResult<FactureDto>? _page;
    private FactureDto? _detail;
    private FiltreFacturesRequete _filtre = new();

    private bool _chargement = true;
    private bool _detailVisible;
    private string _numeroEnCours = string.Empty;

    private static string ClasseStatut(InvoiceStatus statut) => statut switch
    {
        InvoiceStatus.Payee => "etiquette-succes",
        InvoiceStatus.Annulee => "etiquette-danger",
        InvoiceStatus.PartiellementPayee => "etiquette-attention",
        _ => "etiquette-neutre"
    };

    protected override async Task OnInitializedAsync() => await ChargerAsync();

    private async Task ChargerAsync()
    {
        _chargement = true;

        var chemin = $"api/factures?page={_filtre.Page}&taillePage={_filtre.TaillePage}" +
                     $"&seulementImpayees={_filtre.SeulementImpayees}";

        if (!string.IsNullOrWhiteSpace(_filtre.Recherche))
            chemin += $"&recherche={Uri.EscapeDataString(_filtre.Recherche)}";
        if (_filtre.Statut is not null) chemin += $"&statut={_filtre.Statut}";

        var resultat = await Api.ObtenirAsync<PagedResult<FactureDto>>(chemin);
        if (resultat.Succes) _page = resultat.Valeur;
        else Messages.Erreur(resultat.Message);

        _chargement = false;
    }

    private async Task Rechercher(string texte)
    {
        _filtre.Recherche = texte;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task FiltrerStatut(ChangeEventArgs args)
    {
        _filtre.Statut = Enum.TryParse<InvoiceStatus>(args.Value?.ToString(), out var statut) ? statut : null;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task BasculerImpayees(ChangeEventArgs args)
    {
        _filtre.SeulementImpayees = args.Value is true;
        _filtre.Page = 1;
        await ChargerAsync();
    }

    private async Task ChangerPage(int page)
    {
        _filtre.Page = page;
        await ChargerAsync();
    }

    private async Task OuvrirDetail(FactureDto facture)
    {
        var resultat = await Api.ObtenirAsync<FactureDto>($"api/factures/{facture.Id}");

        if (!resultat.Succes)
        {
            Messages.Erreur(resultat.Message);
            return;
        }

        _detail = resultat.Valeur;
        _numeroEnCours = facture.Numero;
        _detailVisible = true;
    }
}
