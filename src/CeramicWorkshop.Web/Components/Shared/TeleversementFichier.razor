@inject ClientApi Api
@inject ServiceMessages Messages

<div class="champ">
    <label for="@_id">@Libelle</label>
    <InputFile id="@_id" class="saisie" OnChange="Deposer" accept="@TypesAcceptes" disabled="@_envoi" />
    <span class="champ-aide">
        @(_envoi ? "Envoi en cours…" : "Images JPG, PNG ou WEBP, ou document PDF — 8 Mo maximum.")
    </span>
</div>

@code {
    private readonly string _id = $"fichier-{Guid.NewGuid():N}";
    private bool _envoi;

    [Parameter] public string Libelle { get; set; } = "Fichier";

    [Parameter] public string TypesAcceptes { get; set; } = "image/jpeg,image/png,image/webp,application/pdf";

    /// <summary>Adresse du fichier une fois déposé sur le serveur.</summary>
    [Parameter] public EventCallback<string> OnDepose { get; set; }

    private async Task Deposer(InputFileChangeEventArgs args)
    {
        var fichier = args.File;

        if (fichier is null)
        {
            return;
        }

        _envoi = true;

        try
        {
            // 8 Mo : la même limite que celle appliquée par le serveur.
            await using var flux = fichier.OpenReadStream(8 * 1024 * 1024);
            var resultat = await Api.DeposerFichierAsync(flux, fichier.Name, fichier.ContentType);

            if (!resultat.Succes || resultat.Valeur is null)
            {
                Messages.Erreur(resultat.Message);
                return;
            }

            await OnDepose.InvokeAsync(resultat.Valeur.Chemin);
        }
        catch (IOException)
        {
            Messages.Erreur("Le fichier dépasse la taille autorisée de 8 Mo.");
        }
        finally
        {
            _envoi = false;
        }
    }
}
