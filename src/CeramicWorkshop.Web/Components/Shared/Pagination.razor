@typeparam TElement

@if (Page is not null && Page.Total > 0)
{
    <div class="pagination">
        <button type="button" class="bouton bouton-secondaire" disabled="@(!Page.PagePrecedenteDisponible)"
                @onclick="() => Aller(Page.Page - 1)">Précédent</button>

        <span class="pagination-position">
            Page @Page.Page sur @Math.Max(Page.NombrePages, 1) — @Page.Total @Libelle
        </span>

        <button type="button" class="bouton bouton-secondaire" disabled="@(!Page.PageSuivanteDisponible)"
                @onclick="() => Aller(Page.Page + 1)">Suivant</button>
    </div>
}

@code {
    [Parameter] public PagedResult<TElement>? Page { get; set; }

    /// <summary>Nom des éléments comptés, au pluriel (« achats », « matières »).</summary>
    [Parameter] public string Libelle { get; set; } = "éléments";

    [Parameter] public EventCallback<int> OnChangerPage { get; set; }

    private Task Aller(int page) => OnChangerPage.InvokeAsync(Math.Max(page, 1));
}
