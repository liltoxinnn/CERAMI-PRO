<div class="statistique @(Alerte ? "statistique-alerte" : string.Empty)">
    <span class="statistique-valeur">@Valeur</span>
    <span class="statistique-libelle">@Libelle</span>
</div>

@code {
    [Parameter, EditorRequired] public string Valeur { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Libelle { get; set; } = string.Empty;

    /// <summary>Met la valeur en évidence lorsqu'elle demande une action.</summary>
    [Parameter] public bool Alerte { get; set; }
}
