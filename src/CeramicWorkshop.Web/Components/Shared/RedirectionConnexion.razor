@inject NavigationManager Navigation

<Chargement Message="Redirection vers la page de connexion…" />

@code {
    /// <summary>
    /// Renvoie vers l'écran de connexion en mémorisant la page demandée,
    /// afin d'y revenir automatiquement après identification.
    /// </summary>
    protected override void OnInitialized()
    {
        var pageDemandee = Navigation.ToBaseRelativePath(Navigation.Uri);
        var destination = string.IsNullOrWhiteSpace(pageDemandee) || pageDemandee.StartsWith("connexion")
            ? "connexion"
            : $"connexion?retour={Uri.EscapeDataString(pageDemandee)}";

        Navigation.NavigateTo(destination, replace: true);
    }
}
