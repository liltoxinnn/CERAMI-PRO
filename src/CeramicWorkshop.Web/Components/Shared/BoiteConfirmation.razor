@if (Visible)
{
    <div class="fenetre-fond" @onclick="Annuler">
        <div class="fenetre" role="dialog" aria-modal="true" aria-labelledby="titre-confirmation"
             @onclick:stopPropagation="true">
            <h2 id="titre-confirmation" class="fenetre-titre">@Titre</h2>
            <p class="fenetre-texte">@Texte</p>

            <div class="fenetre-actions">
                <button type="button" class="bouton bouton-secondaire" @onclick="Annuler">Annuler</button>
                <button type="button" class="bouton @(Dangereux ? "bouton-danger" : "bouton-principal")"
                        @onclick="Confirmer">
                    @LibelleConfirmation
                </button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Affiche ou masque la fenêtre.</summary>
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Titre { get; set; } = "Confirmation";

    [Parameter]
    public string Texte { get; set; } = "Confirmez-vous cette action ?";

    [Parameter]
    public string LibelleConfirmation { get; set; } = "Confirmer";

    /// <summary>Met en évidence une action irréversible.</summary>
    [Parameter]
    public bool Dangereux { get; set; }

    [Parameter]
    public EventCallback OnConfirmer { get; set; }

    [Parameter]
    public EventCallback OnAnnuler { get; set; }

    private Task Confirmer() => OnConfirmer.InvokeAsync();

    private Task Annuler() => OnAnnuler.InvokeAsync();
}
