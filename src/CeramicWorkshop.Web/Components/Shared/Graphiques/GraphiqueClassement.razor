@* Classement : une barre horizontale par élément, triée du plus grand au plus petit. *@

<figure class="graphique">
    <figcaption class="graphique-entete">
        <span class="graphique-titre">@Titre</span>
    </figcaption>

    @if (Lignes.Count == 0)
    {
        <p class="graphique-vide">Aucune donnée pour l'instant.</p>
    }
    else
    {
        <ul class="classement">
            @foreach (var ligne in Lignes.Take(Limite))
            {
                var proportion = Maximum <= 0 ? 0 : (double)(ligne.Montant / Maximum) * 100;
                <li class="classement-ligne">
                    <span class="classement-nom">@ligne.Nom</span>
                    <span class="classement-barre" aria-hidden="true">
                        <span class="classement-remplissage" style="width:@proportion.ToString("0.##", Culture)%"></span>
                    </span>
                    <span class="classement-valeur">
                        @MontantFormatter.Formater(ligne.Montant)
                        <span class="classement-quantite">
                            @MontantFormatter.FormaterQuantite(ligne.Quantite, ligne.Unite)
                        </span>
                    </span>
                </li>
            }
        </ul>
    }
</figure>

@code {
    private static readonly System.Globalization.CultureInfo Culture =
        System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired] public string Titre { get; set; } = string.Empty;

    [Parameter, EditorRequired] public IReadOnlyList<ClassementDto> Lignes { get; set; }
        = Array.Empty<ClassementDto>();

    [Parameter] public int Limite { get; set; } = 6;

    private decimal Maximum => Lignes.Count == 0 ? 0m : Math.Max(1m, Lignes.Max(l => l.Montant));
}
