@implements IDisposable
@inject ServiceMessages Messages

<div class="bandeau-messages" aria-live="polite">
    @foreach (var message in Messages.Messages)
    {
        <div class="message message-@Classe(message.Niveau)" role="alert">
            <span class="message-icone" aria-hidden="true">@Icone(message.Niveau)</span>
            <span class="message-texte">@message.Texte</span>
            <button type="button" class="message-fermer" title="Fermer" aria-label="Fermer le message"
                    @onclick="() => Messages.Fermer(message.Id)">✕</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Messages.Modifie += Rafraichir;

    private void Rafraichir() => InvokeAsync(StateHasChanged);

    private static string Classe(NiveauMessage niveau) => niveau switch
    {
        NiveauMessage.Succes => "succes",
        NiveauMessage.Avertissement => "avertissement",
        NiveauMessage.Erreur => "erreur",
        _ => "information"
    };

    private static string Icone(NiveauMessage niveau) => niveau switch
    {
        NiveauMessage.Succes => "✔",
        NiveauMessage.Avertissement => "⚠",
        NiveauMessage.Erreur => "✕",
        _ => "ℹ"
    };

    public void Dispose() => Messages.Modifie -= Rafraichir;
}
