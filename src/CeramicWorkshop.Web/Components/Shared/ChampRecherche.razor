<div class="champ-recherche">
    <label for="@_id" class="etiquette-visuellement-cachee">@Placeholder</label>
    <input id="@_id" class="saisie" type="search" placeholder="@Placeholder"
           value="@Valeur" @oninput="Changer" />
</div>

@code {
    private readonly string _id = $"recherche-{Guid.NewGuid():N}";

    [Parameter] public string? Valeur { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Rechercher…";

    [Parameter] public EventCallback<string> OnRechercher { get; set; }

    private Task Changer(ChangeEventArgs args)
        => OnRechercher.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
