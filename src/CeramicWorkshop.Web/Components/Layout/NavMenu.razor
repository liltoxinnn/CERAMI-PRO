@inject ServiceAuthentification Authentification

<nav class="menu" aria-label="Menu principal">
    <div class="menu-marque">
        <span class="menu-logo" aria-hidden="true">🏺</span>
        <span class="menu-nom">CERAMIPRO</span>
    </div>

    <ul class="menu-liste">
        @foreach (var groupe in Groupes)
        {
            var entrees = groupe.Entrees.Where(EstVisible).ToList();

            if (entrees.Count == 0)
            {
                continue;
            }

            <li class="menu-groupe">
                <span class="menu-groupe-titre">@groupe.Titre</span>
                <ul>
                    @foreach (var entree in entrees)
                    {
                        <li>
                            <NavLink class="menu-lien" href="@entree.Lien"
                                     Match="@(entree.Lien == string.Empty ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                     @onclick="OnNaviguer">
                                <span class="menu-icone" aria-hidden="true">@entree.Icone</span>
                                <span>@entree.Libelle</span>
                            </NavLink>
                        </li>
                    }
                </ul>
            </li>
        }
    </ul>

    <p class="menu-note">
        Les modules production, clients et ventes s'ajouteront ici au fil des prochaines étapes.
    </p>
</nav>

@code {
    /// <summary>Appelé après un clic, pour refermer le menu sur téléphone.</summary>
    [Parameter]
    public EventCallback OnNaviguer { get; set; }

    private sealed record GroupeMenu(string Titre, IReadOnlyList<ElementMenu> Entrees);

    private static readonly IReadOnlyList<GroupeMenu> Groupes = new List<GroupeMenu>
    {
        new("Atelier", new List<ElementMenu>
        {
            new("Tableau de bord", "", "🏠"),
            new("Scanner un code", "scanner", "📷")
        }),
        new("Stock", new List<ElementMenu>
        {
            new("Matières premières", "stock/matieres", "🧱", PermissionCodes.MatieresConsulter),
            new("Mouvements de stock", "stock/mouvements", "🔄", PermissionCodes.MouvementsConsulter)
        }),
        new("Production", new List<ElementMenu>
        {
            new("Ordres de production", "production", "🏭", PermissionCodes.ProductionConsulter),
            new("Tableau de production", "production/tableau", "📋", PermissionCodes.ProductionConsulter),
            new("Cuissons", "production/cuissons", "🔥", PermissionCodes.CuissonConsulter),
            new("Décoration", "production/decoration", "🎨", PermissionCodes.DecorationConsulter),
            new("Contrôle qualité", "production/qualite", "🔍", PermissionCodes.QualiteConsulter)
        }),
        new("Produits", new List<ElementMenu>
        {
            new("Catalogue", "produits", "🏺", PermissionCodes.ProduitsConsulter),
            new("Recettes", "recettes", "🧪", PermissionCodes.RecettesConsulter),
            new("Étiquettes", "etiquettes", "🏷️", PermissionCodes.ProduitsConsulter)
        }),
        new("Clients", new List<ElementMenu>
        {
            new("Clients", "clients", "👥", PermissionCodes.ClientsConsulter),
            new("Commandes personnalisées", "commandes", "🎨", PermissionCodes.CommandesConsulter),
            new("Dettes clients", "clients/dettes", "⚠️", PermissionCodes.ClientsConsulter)
        }),
        new("Ventes", new List<ElementMenu>
        {
            new("Nouvelle vente", "ventes/nouvelle", "🛒", PermissionCodes.VentesCreer),
            new("Historique des ventes", "ventes", "📑", PermissionCodes.VentesConsulter),
            new("Factures", "factures", "📄", PermissionCodes.FacturesConsulter),
            new("Paiements", "paiements", "💳", PermissionCodes.PaiementsConsulter)
        }),
        new("Fournisseurs", new List<ElementMenu>
        {
            new("Fournisseurs", "fournisseurs", "🚚", PermissionCodes.FournisseursConsulter),
            new("Achats", "achats", "📦", PermissionCodes.AchatsConsulter)
        }),
        new("Gestion", new List<ElementMenu>
        {
            new("Dépenses", "depenses", "💸", PermissionCodes.DepensesConsulter),
            new("Rapports", "rapports", "📊", PermissionCodes.RapportsConsulter),
            new("Calculateurs", "calculateurs", "🧮")
        }),
        new("Administration", new List<ElementMenu>
        {
            new("Utilisateurs", "utilisateurs", "👤", PermissionCodes.UtilisateursConsulter),
            new("Rôles et droits", "roles", "🔐", PermissionCodes.UtilisateursConsulter),
            new("Listes de référence", "parametres/listes", "🗂️", PermissionCodes.MatieresConsulter),
            new("Paramètres", "parametres", "⚙️", PermissionCodes.ParametresConsulter)
        })
    };

    private bool EstVisible(ElementMenu entree)
        => entree.DroitRequis is null || Authentification.Session.PossedeDroit(entree.DroitRequis);
}
