@inherits LayoutComponentBase
@implements IDisposable
@inject ServiceAuthentification Authentification
@inject NavigationManager Navigation
@inject ClientApi Api

<div class="application @(_menuOuvert ? "menu-ouvert" : string.Empty)">
    <NavMenu OnNaviguer="FermerMenu" />

    <div class="zone-principale">
        <header class="entete">
            <button type="button" class="bouton-menu" title="Afficher le menu" aria-label="Afficher le menu"
                    @onclick="BasculerMenu">
                ☰
            </button>

            <div class="entete-titre">
                <span class="entete-marque">CERAMIPRO</span>
                <span class="entete-sous-titre">Gestion d'atelier de céramique</span>
            </div>

            <AuthorizeView>
                <Authorized>
                    <form class="entete-recherche" @onsubmit="Chercher" @onsubmit:preventDefault>
                        <input class="saisie saisie-compacte" type="search" aria-label="Recherche globale"
                               placeholder="Rechercher dans tout l'atelier…" value="@_recherche"
                               @oninput="args => _recherche = args.Value?.ToString() ?? string.Empty" />
                        <button type="submit" class="bouton bouton-discret" title="Chercher"
                                aria-label="Lancer la recherche">🔎</button>
                    </form>

                    <div class="entete-utilisateur">
                        <a class="entete-alertes" href="alertes" title="Alertes de l'atelier">
                            🔔
                            @if (_alertes > 0)
                            {
                                <span class="entete-pastille" aria-label="@($"{_alertes} alerte(s) non lue(s)")">
                                    @(_alertes > 99 ? "99+" : _alertes.ToString())
                                </span>
                            }
                        </a>

                        <div class="entete-identite">
                            <span class="entete-nom">@Session.Profil?.NomComplet</span>
                            <span class="entete-role">@Session.Profil?.RoleNom</span>
                        </div>
                        <a class="bouton bouton-discret" href="mon-compte">Mon compte</a>
                        <button type="button" class="bouton bouton-secondaire" @onclick="SeDeconnecter">
                            Se déconnecter
                        </button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="contenu">
            <BandeauMessages />
            @Body
        </main>

        <footer class="pied-de-page">
            <span>CERAMIPRO — Logiciel de gestion d'atelier</span>
        </footer>
    </div>
</div>

@code {
    private bool _menuOuvert;
    private string _recherche = string.Empty;
    private int _alertes;

    private SessionUtilisateur Session => Authentification.Session;

    protected override void OnInitialized() => Authentification.EtatModifie += Rafraichir;

    protected override async Task OnAfterRenderAsync(bool premierRendu)
    {
        if (premierRendu && Session.EstConnecte)
        {
            await CompterAlertesAsync();
        }
    }

    /// <summary>Nombre d'alertes non lues, affiché dans la cloche de l'en-tête.</summary>
    private async Task CompterAlertesAsync()
    {
        var resume = await Api.ObtenirAsync<ResumeAlertesDto>("api/alertes/resume");

        if (resume.Succes && resume.Valeur is not null)
        {
            _alertes = resume.Valeur.NonLues;
            StateHasChanged();
        }
    }

    private void Chercher()
    {
        if (string.IsNullOrWhiteSpace(_recherche) || _recherche.Trim().Length < 2)
        {
            return;
        }

        Navigation.NavigateTo($"recherche?terme={Uri.EscapeDataString(_recherche.Trim())}");
        _recherche = string.Empty;
    }

    private void Rafraichir() => InvokeAsync(StateHasChanged);

    private void BasculerMenu() => _menuOuvert = !_menuOuvert;

    private void FermerMenu() => _menuOuvert = false;

    private async Task SeDeconnecter()
    {
        await Authentification.DeconnexionAsync();
        Navigation.NavigateTo("connexion", replace: true);
    }

    public void Dispose() => Authentification.EtatModifie -= Rafraichir;
}
