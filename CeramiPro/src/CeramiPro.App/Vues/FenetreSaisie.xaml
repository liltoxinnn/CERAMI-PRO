<Window x:Class="CeramiPro.App.Vues.FenetreSaisie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Fond}"
        FontFamily="{StaticResource PoliceInterface}">

    <!--
        Demande d'un court texte : le motif d'une annulation, par exemple.
        La question est posée en clair, le champ a le focus dès l'ouverture,
        et Entrée valide comme Échap annule.
    -->

    <StackPanel Margin="24">

        <TextBlock x:Name="Question" TextWrapping="Wrap" FontSize="13.5"
                   Foreground="{StaticResource Texte}" Margin="0,0,0,14" />

        <TextBox x:Name="Reponse" MinHeight="38" Padding="10,8" FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="{StaticResource Surface}"
                 BorderBrush="{StaticResource Bordure}" BorderThickness="1" />

        <TextBlock x:Name="Erreur" Visibility="Collapsed" Margin="0,8,0,0" FontSize="12"
                   Foreground="{StaticResource Danger}" TextWrapping="Wrap"
                   Text="Ce champ est obligatoire." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" IsCancel="True"
                    Style="{StaticResource BoutonSecondaire}" MinWidth="110" Margin="0,0,8,0" />

            <Button Content="Valider" Click="Valider" IsDefault="True"
                    Style="{StaticResource BoutonPrincipal}" MinWidth="120" />
        </StackPanel>
    </StackPanel>
</Window>
