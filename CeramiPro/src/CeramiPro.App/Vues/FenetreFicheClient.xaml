<Window x:Class="CeramiPro.App.Vues.FenetreFicheClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Width="1040" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Fond}"
        FontFamily="{StaticResource PoliceInterface}">

    <!--
        Fiche d'un client : coordonnées et chiffres en haut, puis l'historique
        en onglets — ventes, commandes, paiements — et les notes prises au fil
        des échanges.
    -->

    <Window.Resources>
        <Style x:Key="LibelleChiffre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
        </Style>
        <Style x:Key="ValeurChiffre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">

        <!-- En-tête -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{Binding Client.Nom}" Style="{StaticResource TitrePage}" />
            <TextBlock Text="{Binding Coordonnees}" Style="{StaticResource IntroductionPage}" />
            <TextBlock Text="{Binding Resume}" Style="{StaticResource IntroductionPage}" Margin="0,2,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Fermer" IsCancel="True" Click="Fermer"
                    Style="{StaticResource BoutonSecondaire}" MinWidth="110" />
        </DockPanel>

        <!-- Chiffres -->
        <Grid DockPanel.Dock="Top" Margin="0,0,-12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Carte}" Margin="0,0,12,12" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Total acheté (ventes et commandes)" Style="{StaticResource LibelleChiffre}" />
                    <TextBlock Text="{Binding TotalAchete}" Style="{StaticResource ValeurChiffre}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Carte}" Margin="0,0,12,12" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Déjà payé" Style="{StaticResource LibelleChiffre}" />
                    <TextBlock Text="{Binding TotalPaye}" Style="{StaticResource ValeurChiffre}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Carte}" Margin="0,0,12,12" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Reste dû" Style="{StaticResource LibelleChiffre}" />
                    <TextBlock Text="{Binding Reste}" Style="{StaticResource ValeurChiffre}" />
                    <TextBlock Text="⚠ Ce client a un solde à régler." FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource Danger}"
                               Visibility="{Binding Doit, Converter={StaticResource BooleenEnVisibilite}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource DangerFond}" CornerRadius="6"
                Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding MessageErreur, Converter={StaticResource TexteEnVisibilite}}">
            <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" FontSize="12.5" />
        </Border>

        <!-- Historique -->
        <TabControl>
            <TabItem Header="Ventes">
                <DataGrid ItemsSource="{Binding Ventes}" Style="{StaticResource TableauDonnees}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Numéro" Binding="{Binding Numero}" Width="*" />
                        <DataGridTextColumn Header="Date" Width="*"
                                            Binding="{Binding Date, Converter={StaticResource DateEnTexte}, ConverterParameter=heure}" />
                        <DataGridTextColumn Header="Total" Width="*"
                                            Binding="{Binding Total, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Payé" Width="*"
                                            Binding="{Binding Paye, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Reste" Width="*"
                                            Binding="{Binding Reste, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding StatutLibelle}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Commandes">
                <DataGrid ItemsSource="{Binding Commandes}" Style="{StaticResource TableauDonnees}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Numéro" Binding="{Binding Numero}" Width="*" />
                        <DataGridTextColumn Header="Commande" Binding="{Binding Titre}" Width="2*" />
                        <DataGridTextColumn Header="Reçue par" Binding="{Binding CanalLibelle}" Width="*" />
                        <DataGridTextColumn Header="À livrer le" Width="*"
                                            Binding="{Binding DateLimite, Converter={StaticResource DateEnTexte}}" />
                        <DataGridTextColumn Header="Total" Width="*"
                                            Binding="{Binding Total, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Versé" Width="*"
                                            Binding="{Binding Paye, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Reste" Width="*"
                                            Binding="{Binding Reste, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Étape" Binding="{Binding StatutLibelle}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Paiements">
                <DataGrid ItemsSource="{Binding Paiements}" Style="{StaticResource TableauDonnees}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Numéro" Binding="{Binding Numero}" Width="*" />
                        <DataGridTextColumn Header="Date" Width="*"
                                            Binding="{Binding Date, Converter={StaticResource DateEnTexte}}" />
                        <DataGridTextColumn Header="Montant" Width="*"
                                            Binding="{Binding Montant, Converter={StaticResource MontantEnTexte}}" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding ModeReglement}" Width="*" />
                        <DataGridTextColumn Header="Vente" Binding="{Binding VenteNumero}" Width="*" />
                        <DataGridTextColumn Header="Commande" Binding="{Binding CommandeNumero}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Notes">
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Ajouter la note" Command="{Binding AjouterNoteCommand}"
                                Style="{StaticResource BoutonPrincipal}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource Saisie}" MaxLength="2000"
                                 Text="{Binding NouvelleNote, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AjouterNoteCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Carte}" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Contenu}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="{StaticResource Texte}" />
                                        <TextBlock FontSize="11.5" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TexteSecondaire}">
                                            <Run Text="{Binding Date, Mode=OneWay, Converter={StaticResource DateEnTexte}, ConverterParameter=heure}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding Auteur, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
