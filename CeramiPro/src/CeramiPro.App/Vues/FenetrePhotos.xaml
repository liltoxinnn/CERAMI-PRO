<Window x:Class="CeramiPro.App.Vues.FenetrePhotos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titre}"
        Width="980" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Fond}"
        FontFamily="{StaticResource PoliceInterface}">

    <!--
        Photos d'un produit ou d'une commande : la photo choisie en grand, les
        autres en miniatures. Les fichiers sont recopiés dans le dossier des
        photos de CeramiPro : effacer l'original ne fait rien perdre.
    -->

    <DockPanel Margin="24">

        <!-- En-tête -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{Binding Titre}" Style="{StaticResource TitrePage}" />
            <TextBlock Text="{Binding Introduction}" Style="{StaticResource IntroductionPage}" />
        </StackPanel>

        <!-- Boutons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" IsCancel="True" Click="Fermer"
                    Style="{StaticResource BoutonSecondaire}" MinWidth="110" />

            <WrapPanel>
                <Button Content="📷  Ajouter des photos…" Command="{Binding AjouterCommand}"
                        Style="{StaticResource BoutonPrincipal}" Margin="0,0,8,0" />
                <Button Content="★  Photo principale" Command="{Binding DefinirPrincipaleCommand}"
                        Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                        ToolTip="La photo choisie représentera le produit dans le catalogue."
                        IsEnabled="{Binding PhotoEstChoisie}"
                        Visibility="{Binding GerePrincipale, Converter={StaticResource BooleenEnVisibilite}}" />
                <Button Content="Ouvrir en grand" Command="{Binding OuvrirCommand}"
                        Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                        IsEnabled="{Binding PhotoEstChoisie}" />
                <Button Content="Retirer la photo" Command="{Binding SupprimerCommand}"
                        Style="{StaticResource BoutonDanger}"
                        IsEnabled="{Binding PhotoEstChoisie}" />
            </WrapPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource DangerFond}" CornerRadius="6"
                Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding MessageErreur, Converter={StaticResource TexteEnVisibilite}}">
            <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" FontSize="12.5" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Photo choisie -->
            <Border Style="{StaticResource Carte}" Margin="0" Padding="12">
                <Grid>
                    <Image Source="{Binding PhotoChoisie.CheminComplet, Converter={StaticResource CheminEnImage},
                                    ConverterParameter=1400}"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="Aucune photo pour l'instant. Cliquez sur « Ajouter des photos… » et choisissez une ou plusieurs images."
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" FontSize="13.5"
                               Visibility="{Binding AucunePhoto, Converter={StaticResource BooleenEnVisibilite}}" />

                    <TextBlock Text="Le fichier de cette photo est introuvable."
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{StaticResource Danger}" FontSize="13"
                               Visibility="{Binding PhotoChoisie.Introuvable, Converter={StaticResource BooleenEnVisibilite},
                                            FallbackValue=Collapsed}" />

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="{StaticResource TerreClaire}"
                            CornerRadius="4" Padding="8,3"
                            Visibility="{Binding PhotoChoisie.Principale, Converter={StaticResource BooleenEnVisibilite},
                                         FallbackValue=Collapsed}">
                        <TextBlock Text="★ Photo principale" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TerreFoncee}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Miniatures -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Compte}" Style="{StaticResource TitreCarte}" />

                <ListBox ItemsSource="{Binding Photos}" SelectedItem="{Binding PhotoChoisie}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="116" Height="134" Margin="2" Padding="4" CornerRadius="6"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}" BorderThickness="1"
                                    ToolTip="{Binding Legende}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Text="★ Principale" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{StaticResource TerreFoncee}" FontWeight="SemiBold"
                                               Visibility="{Binding Principale, Converter={StaticResource BooleenEnVisibilite}}" />
                                    <Grid>
                                        <Image Source="{Binding CheminComplet, Converter={StaticResource CheminEnImage},
                                                        ConverterParameter=240}"
                                               Stretch="UniformToFill" />
                                        <TextBlock Text="Introuvable" FontSize="11" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Danger}"
                                                   Visibility="{Binding Introuvable, Converter={StaticResource BooleenEnVisibilite}}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
