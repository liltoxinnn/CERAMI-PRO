<UserControl x:Class="CeramiPro.App.Vues.TableauProductionVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PoliceInterface}">

    <!--
        Tableau de production : une colonne par étape de fabrication.
        Les colonnes défilent horizontalement, ce qui permet de garder les
        neuf étapes de l'atelier sans les tasser.
    -->

    <DockPanel>

        <!-- Actions sur l'ordre choisi -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Carte}" Margin="0,12,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="Faire avancer la fabrication" Style="{StaticResource TitreCarte}" />

                <TextBlock Style="{StaticResource IntroductionPage}" Margin="0,0,0,10">
                    <Run Text="Ordre choisi : " /><Run
                        Text="{Binding OrdreSelectionne.Numero, TargetNullValue=aucun}"
                        FontWeight="SemiBold" /><Run Text=" — " /><Run
                        Text="{Binding OrdreSelectionne.ProduitNom, TargetNullValue=—}" />
                </TextBlock>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Pièces acceptées" Style="{StaticResource EtiquetteChamp}" />
                        <TextBox Style="{StaticResource Saisie}" Width="120"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding QuantiteAcceptee, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Pièces cassées" Style="{StaticResource EtiquetteChamp}" />
                        <TextBox Style="{StaticResource Saisie}" Width="120"
                                 HorizontalContentAlignment="Right"
                                 Text="{Binding QuantiteEndommagee, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Observations" Style="{StaticResource EtiquetteChamp}" />
                        <TextBox Style="{StaticResource Saisie}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Lancer la fabrication" Command="{Binding LancerCommand}"
                                Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0"
                                IsEnabled="{Binding PeutLancer}" />

                        <Button Content="{Binding LibelleEtapeSuivante}" Command="{Binding AvancerCommand}"
                                Style="{StaticResource BoutonPrincipal}" Margin="0,0,8,0"
                                IsEnabled="{Binding PeutAvancer}" />

                        <Button Content="Annuler l'ordre" Command="{Binding AnnulerOrdreCommand}"
                                Style="{StaticResource BoutonDanger}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Actualiser"
                        Command="{Binding ActualiserCommand}"
                        Style="{StaticResource BoutonSecondaire}" />

                <Border Background="{StaticResource DangerFond}" CornerRadius="6" Padding="12,9"
                        Margin="0,0,12,0"
                        Visibility="{Binding MessageErreur,
                                     Converter={StaticResource TexteEnVisibilite}}">
                    <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                               Foreground="{StaticResource Danger}" FontSize="12.5" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Colonnes -->
        <Grid MinHeight="300">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Colonnes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Margin="0,0,12,0" CornerRadius="8"
                                    Background="{StaticResource Fond}"
                                    BorderBrush="{StaticResource Bordure}" BorderThickness="1">
                                <DockPanel>

                                    <Border DockPanel.Dock="Top" Background="{StaticResource Ardoise}"
                                            CornerRadius="8,8,0,0" Padding="12,10">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right"
                                                    Background="{StaticResource ArdoiseSurvol}"
                                                    CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="{Binding Ordres.Count}"
                                                           Foreground="{StaticResource TexteInverse}"
                                                           FontSize="11.5" FontWeight="Bold" />
                                            </Border>

                                            <TextBlock Text="{Binding EtapeLibelle}"
                                                       Foreground="{StaticResource TexteInverse}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420"
                                                  Padding="8">
                                        <ItemsControl ItemsSource="{Binding Ordres}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button HorizontalContentAlignment="Stretch"
                                                            BorderThickness="0" Padding="0"
                                                            Cursor="Hand" Margin="0,0,0,8"
                                                            Command="{Binding DataContext.ChoisirCommand,
                                                                      RelativeSource={RelativeSource
                                                                        AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Fiche"
                                                                        Background="{StaticResource Surface}"
                                                                        BorderBrush="{StaticResource Bordure}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6" Padding="10">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Fiche"
                                                                                Property="BorderBrush"
                                                                                Value="{StaticResource Terre}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Numero}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{StaticResource Terre}" />
                                                            <TextBlock Text="{Binding ProduitNom}"
                                                                       FontSize="12.5" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock FontSize="11" Margin="0,4,0,0"
                                                                       Foreground="{StaticResource TexteSecondaire}">
                                                                <Run Text="{Binding QuantitePrevue,
                                                                           StringFormat=N0, Mode=OneWay}" /><Run
                                                                    Text=" pièce(s) · " /><Run
                                                                    Text="{Binding PrioriteLibelle}" />
                                                            </TextBlock>
                                                            <TextBlock Text="En retard" FontSize="10.5"
                                                                       FontWeight="Bold" Margin="0,4,0,0"
                                                                       Foreground="{StaticResource Danger}"
                                                                       Visibility="{Binding EnRetard,
                                                                         Converter={StaticResource BooleenEnVisibilite}}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{StaticResource Surface}" CornerRadius="8"
                    BorderBrush="{StaticResource Bordure}" BorderThickness="1"
                    Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding AucunOrdre, Converter={StaticResource BooleenEnVisibilite}}">
                <TextBlock Text="Aucune fabrication en cours." FontSize="14"
                           Foreground="{StaticResource TexteSecondaire}" />
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
