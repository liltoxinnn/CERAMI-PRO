<UserControl x:Class="CeramiPro.App.Vues.SauvegardeVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PoliceInterface}">

    <DockPanel>

        <!-- État du dispositif -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Carte}">
            <StackPanel>
                <TextBlock Text="État des sauvegardes" Style="{StaticResource TitreCarte}" />

                <UniformGrid Columns="4" Margin="0,4,0,0">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Sauvegarde automatique" Style="{StaticResource EtiquetteChamp}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <Run Text="{Binding AutomatiqueActive,
                                       Converter={StaticResource BooleenEnOuiNon}, Mode=OneWay}" /><Run
                                Text=" — " /><Run Text="{Binding HeureAutomatique, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Conservation" Style="{StaticResource EtiquetteChamp}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <Run Text="{Binding ConservationJours, Mode=OneWay}" /><Run Text=" jour(s)" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Dernière sauvegarde" Style="{StaticResource EtiquetteChamp}" />
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="{Binding DerniereSauvegarde, StringFormat=dd/MM/yyyy HH:mm,
                                          TargetNullValue=Jamais}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Base de données" Style="{StaticResource EtiquetteChamp}" />
                        <TextBlock Text="{Binding NomBaseDeDonnees}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="Dossier des sauvegardes" Style="{StaticResource EtiquetteChamp}"
                           Margin="0,12,0,2" />
                <TextBlock Text="{Binding Dossier}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource TexteSecondaire}" />
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Sauvegarder maintenant" Command="{Binding SauvegarderCommand}"
                        Style="{StaticResource BoutonPrincipal}" Margin="0,0,8,0"
                        IsEnabled="{Binding ChargementEnCours, Converter={StaticResource BooleenInverse}}" />

                <Button Content="Copier sur une clé USB…" Command="{Binding CopierCommand}"
                        Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0" />

                <Button Content="Ouvrir le dossier" Command="{Binding OuvrirDossierCommand}"
                        Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0" />

                <Button Content="Purger les anciennes" Command="{Binding PurgerCommand}"
                        Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0" />

                <Button Content="Supprimer" Command="{Binding SupprimerCommand}"
                        Style="{StaticResource BoutonDanger}" />
            </WrapPanel>
        </Border>

        <!-- Message d'erreur -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DangerFond}" CornerRadius="6"
                Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding MessageErreur, Converter={StaticResource TexteEnVisibilite}}">
            <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" FontSize="12.5" />
        </Border>

        <!-- Liste des archives -->
        <Grid MinHeight="220">
            <DataGrid ItemsSource="{Binding Sauvegardes}"
                      SelectedItem="{Binding SauvegardeSelectionnee}"
                      Style="{StaticResource TableauDonnees}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fichier" Binding="{Binding NomFichier}" Width="3*" />
                    <DataGridTextColumn Header="Date" Width="Auto"
                                        Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" />
                    <DataGridTextColumn Header="Taille" Binding="{Binding TailleAffichee}" Width="Auto" />
                    <DataGridTextColumn Header="Automatique" Width="Auto"
                                        Binding="{Binding Automatique,
                                                  Converter={StaticResource BooleenEnOuiNon}}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="{StaticResource AvertissementFond}" CornerRadius="8"
                    BorderBrush="{StaticResource Avertissement}" BorderThickness="1"
                    Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding AucuneSauvegarde,
                                 Converter={StaticResource BooleenEnVisibilite}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Aucune sauvegarde pour l'instant." FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource Avertissement}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Cliquez sur « Sauvegarder maintenant » pour en créer une première."
                               FontSize="12.5" Margin="0,6,0,0"
                               Foreground="{StaticResource TexteSecondaire}" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
