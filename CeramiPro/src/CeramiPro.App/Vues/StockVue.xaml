<UserControl x:Class="CeramiPro.App.Vues.StockVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PoliceInterface}">

    <!--
        Vue générale du stock : les chiffres en haut, puis uniquement ce qui
        manque. Une liste de tout ce qui va bien n'appellerait aucune action.
    -->

    <StackPanel>

        <!-- Chiffres clés -->
        <UniformGrid Rows="1" Margin="0,0,0,16">
            <Border Style="{StaticResource Carte}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Valeur des matières" Style="{StaticResource EtiquetteChamp}" />
                    <TextBlock Text="{Binding ValeurMatieres}" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource Terre}" />
                    <TextBlock FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TexteSecondaire}">
                        <Run Text="{Binding NombreMatieres, Mode=OneWay}" /><Run Text=" référence(s)" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Valeur des produits finis" Style="{StaticResource EtiquetteChamp}" />
                    <TextBlock Text="{Binding ValeurProduits}" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource Terre}" />
                    <TextBlock FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TexteSecondaire}">
                        <Run Text="{Binding NombreProduits, Mode=OneWay}" /><Run Text=" produit(s)" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}" Margin="0,0,12,0"
                    Background="{StaticResource TerreClaire}" BorderBrush="{StaticResource Terre}">
                <StackPanel>
                    <TextBlock Text="Valeur totale du stock" Style="{StaticResource EtiquetteChamp}" />
                    <TextBlock Text="{Binding ValeurTotale}" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource TerreFoncee}" />
                    <TextBlock Text="Matières et produits réunis" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TexteSecondaire}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Carte}">
                <StackPanel>
                    <TextBlock Text="À réapprovisionner" Style="{StaticResource EtiquetteChamp}" />
                    <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource Danger}">
                        <Run Text="{Binding MatieresFaibles, Mode=OneWay}" /><Run Text=" + " /><Run
                            Text="{Binding ProduitsFaibles, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="Matières + produits sous le seuil" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TexteSecondaire}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Button Content="Actualiser" Command="{Binding ActualiserCommand}"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Left"
                Margin="0,0,0,16" />

        <!-- Tout va bien -->
        <Border Background="{StaticResource SuccesFond}" CornerRadius="8"
                BorderBrush="{StaticResource Succes}" BorderThickness="1" Padding="24"
                Visibility="{Binding StockSain, Converter={StaticResource BooleenEnVisibilite}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{StaticResource Succes}" />
                <TextBlock Text="Aucun article n'est passé sous son seuil d'alerte."
                           FontSize="14" Margin="0,8,0,0" Foreground="{StaticResource Succes}" />
            </StackPanel>
        </Border>

        <!-- Matières à réapprovisionner -->
        <Border Style="{StaticResource Carte}"
                Visibility="{Binding StockSain, Converter={StaticResource BooleenEnVisibiliteInverse}}">
            <StackPanel>
                <TextBlock Text="Matières premières sous le seuil" Style="{StaticResource TitreCarte}" />

                <DataGrid ItemsSource="{Binding AlertesMatieres}" Style="{StaticResource TableauDonnees}"
                          MaxHeight="280" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="Auto" />
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*" />
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding CategorieNom}" Width="*" />
                        <DataGridTextColumn Header="Reste" Width="Auto"
                                            Binding="{Binding QuantiteActuelle, StringFormat=N2}" />
                        <DataGridTextColumn Header="Unité" Binding="{Binding UniteCode}" Width="Auto" />
                        <DataGridTextColumn Header="Seuil" Width="Auto"
                                            Binding="{Binding StockMinimum, StringFormat=N2}" />
                        <DataGridTextColumn Header="Fournisseur" Binding="{Binding FournisseurNom}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Produits à refabriquer -->
        <Border Style="{StaticResource Carte}"
                Visibility="{Binding StockSain, Converter={StaticResource BooleenEnVisibiliteInverse}}">
            <StackPanel>
                <TextBlock Text="Produits finis sous le seuil" Style="{StaticResource TitreCarte}" />

                <DataGrid ItemsSource="{Binding AlertesProduits}" Style="{StaticResource TableauDonnees}"
                          MaxHeight="280" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="Auto" />
                        <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*" />
                        <DataGridTextColumn Header="Catégorie" Binding="{Binding CategorieNom}" Width="*" />
                        <DataGridTextColumn Header="En stock" Width="Auto"
                                            Binding="{Binding StockActuel, StringFormat=N2}" />
                        <DataGridTextColumn Header="Seuil" Width="Auto"
                                            Binding="{Binding StockMinimum, StringFormat=N2}" />
                        <DataGridTextColumn Header="Prix de vente" Width="Auto"
                                            Binding="{Binding PrixVente, StringFormat=N2}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
