<Window x:Class="CeramiPro.App.Vues.FenetreConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CeramiPro"
        Height="520" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Fond}"
        FontFamily="{StaticResource PoliceInterface}"
        FlowDirection="{Binding Sens, Converter={StaticResource SensEnFlowDirection}}">

    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Marque -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,28">
            <TextBlock Text="🏺" FontSize="44" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding NomApplication}" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource Terre}" HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding SousTitreApplication}" FontSize="12"
                       Foreground="{StaticResource TexteSecondaire}"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Formulaire -->
        <Border Grid.Row="1" Style="{StaticResource Carte}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding TitreEcran}" Style="{StaticResource TitreCarte}" />

                <TextBlock Text="{Binding LibelleNomUtilisateur}" Style="{StaticResource EtiquetteChamp}" />
                <TextBox x:Name="ChampNomUtilisateur" Style="{StaticResource Saisie}"
                         Text="{Binding NomUtilisateur, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding LibelleMotDePasse}" Style="{StaticResource EtiquetteChamp}"
                           Margin="0,14,0,4" />
                <PasswordBox x:Name="ChampMotDePasse" Padding="10,8" MinHeight="38"
                             VerticalContentAlignment="Center"
                             Background="{StaticResource Surface}"
                             BorderBrush="{StaticResource Bordure}" BorderThickness="1"
                             PasswordChanged="ChampMotDePasse_PasswordChanged"
                             KeyDown="ChampMotDePasse_KeyDown" />

                <!-- Message d'échec, affiché seulement s'il y en a un -->
                <Border Background="{StaticResource DangerFond}" CornerRadius="6"
                        Padding="12,9" Margin="0,14,0,0"
                        Visibility="{Binding MessageErreur,
                                     Converter={StaticResource TexteEnVisibilite}}">
                    <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                               Foreground="{StaticResource Danger}" FontSize="12.5" />
                </Border>

                <Button Content="{Binding LibelleConnexion}"
                        Command="{Binding ConnecterCommand}"
                        Style="{StaticResource BoutonPrincipal}"
                        IsDefault="True" Margin="0,18,0,0" Height="42"
                        IsEnabled="{Binding ChargementEnCours,
                                    Converter={StaticResource BooleenInverse}}" />
            </StackPanel>
        </Border>

        <!-- Choix de la langue -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Langues}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Converter={StaticResource LangueEnNom}}"
                            Command="{Binding DataContext.ChoisirLangueCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource BoutonSecondaire}"
                            Margin="4,0" Padding="14,6" FontSize="12" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
