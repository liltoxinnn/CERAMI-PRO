<UserControl x:Class="CeramiPro.App.Vues.CalculateursVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PoliceInterface}">

    <!--
        Deux calculs de préparation. Rien n'est enregistré : ces écrans
        servent à chiffrer un devis ou à préparer une fabrication.
    -->

    <StackPanel>

        <Border Background="{StaticResource DangerFond}" CornerRadius="6" Padding="12,9"
                Margin="0,0,0,12"
                Visibility="{Binding MessageErreur, Converter={StaticResource TexteEnVisibilite}}">
            <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" FontSize="12.5" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Surface -->
            <Border Grid.Column="0" Style="{StaticResource Carte}" Margin="0,0,8,16">
                <StackPanel>
                    <TextBlock Text="Surface à couvrir" Style="{StaticResource TitreCarte}" />
                    <TextBlock Text="Carrelage, plans de travail, murs : la surface nécessaire, perte comprise."
                               Style="{StaticResource IntroductionPage}" Margin="0,0,0,12" />

                    <TextBlock Text="Longueur d'une pièce (m)" Style="{StaticResource EtiquetteChamp}" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding Longueur, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Largeur d'une pièce (m)" Style="{StaticResource EtiquetteChamp}"
                               Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding Largeur, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Nombre de pièces" Style="{StaticResource EtiquetteChamp}"
                               Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding NombrePieces, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Perte prévue (%)" Style="{StaticResource EtiquetteChamp}"
                               Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding Pertesurface, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Calculer" Command="{Binding CalculerSurfaceCommand}"
                            Style="{StaticResource BoutonPrincipal}" Margin="0,14,0,0" />

                    <Border Background="{StaticResource TerreClaire}" CornerRadius="6" Padding="14"
                            Margin="0,14,0,0"
                            Visibility="{Binding SurfaceCalculee,
                                         Converter={StaticResource BooleenEnVisibilite}}">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Surface d'une pièce" FontSize="12.5" />
                                <TextBlock Text="{Binding SurfaceUnitaire}" FontSize="12.5"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Surface totale" FontSize="12.5" />
                                <TextBlock Text="{Binding SurfaceTotale}" FontSize="12.5"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Perte" FontSize="12.5" />
                                <TextBlock Text="{Binding SurfacePerte}" FontSize="12.5"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource Terre}" Margin="0,8" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="À prévoir" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SurfaceAvecPerte}" FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TerreFoncee}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Quantité -->
            <Border Grid.Column="1" Style="{StaticResource Carte}" Margin="8,0,0,16">
                <StackPanel>
                    <TextBlock Text="Quantité à lancer" Style="{StaticResource TitreCarte}" />
                    <TextBlock Text="Combien de pièces mettre en fabrication pour en obtenir le nombre voulu."
                               Style="{StaticResource IntroductionPage}" Margin="0,0,0,12" />

                    <TextBlock Text="Quantité souhaitée" Style="{StaticResource EtiquetteChamp}" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding QuantiteSouhaitee, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Quantité par unité ou par carton"
                               Style="{StaticResource EtiquetteChamp}" Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding QuantiteParUnite, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Perte prévue (%)" Style="{StaticResource EtiquetteChamp}"
                               Margin="0,10,0,4" />
                    <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                             Text="{Binding PerteQuantite, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Calculer" Command="{Binding CalculerQuantiteCommand}"
                            Style="{StaticResource BoutonPrincipal}" Margin="0,14,0,0" />

                    <Border Background="{StaticResource TerreClaire}" CornerRadius="6" Padding="14"
                            Margin="0,14,0,0"
                            Visibility="{Binding QuantiteCalculee,
                                         Converter={StaticResource BooleenEnVisibilite}}">
                        <StackPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Sans perte" FontSize="12.5" />
                                <TextBlock Text="{Binding QuantiteNecessaire}" FontSize="12.5"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Left" Text="Unités ou cartons" FontSize="12.5" />
                                <TextBlock Text="{Binding UnitesNecessaires}" FontSize="12.5"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource Terre}" Margin="0,8" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="À lancer" FontSize="14"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding QuantiteAvecPerte}" FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TerreFoncee}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
