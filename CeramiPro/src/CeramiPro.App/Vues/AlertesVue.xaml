<UserControl x:Class="CeramiPro.App.Vues.AlertesVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PoliceInterface}">

    <!--
        Centre d'alertes. Chaque alerte porte un titre en toutes lettres :
        la couleur de la pastille vient en renfort, jamais seule.
    -->

    <DockPanel>

        <!-- Compteurs et actions -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox Content="Seulement les non lues" VerticalAlignment="Center"
                              Margin="0,0,16,0" IsChecked="{Binding SeulementNonLues}" />

                    <Button Content="Tout marquer comme lu" Command="{Binding ToutMarquerLuCommand}"
                            Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0" />

                    <Button Content="Actualiser" Command="{Binding ActualiserCommand}"
                            Style="{StaticResource BoutonPrincipal}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Margin="0,0,20,0">
                        <Run Text="{Binding Total, Mode=OneWay}" FontWeight="Bold" /><Run Text=" au total" />
                    </TextBlock>
                    <TextBlock FontSize="13" Margin="0,0,20,0"
                               Foreground="{StaticResource Avertissement}">
                        <Run Text="{Binding NonLues, Mode=OneWay}" FontWeight="Bold" /><Run Text=" non lue(s)" />
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource Danger}">
                        <Run Text="{Binding Critiques, Mode=OneWay}" FontWeight="Bold" /><Run Text=" critique(s)" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Liste -->
        <Grid MinHeight="240">
            <ItemsControl ItemsSource="{Binding Alertes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}" CornerRadius="8"
                                BorderBrush="{StaticResource Bordure}" BorderThickness="1"
                                Padding="16" Margin="0,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="6" CornerRadius="3"
                                        Margin="0,0,14,0"
                                        Background="{Binding Gravite,
                                                     Converter={StaticResource GraviteEnCouleur}}" />

                                <Button DockPanel.Dock="Right" Content="Marquer comme lue"
                                        Style="{StaticResource BoutonSecondaire}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        Command="{Binding DataContext.MarquerLueCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Lue,
                                                     Converter={StaticResource BooleenEnVisibiliteInverse}}" />

                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding GraviteLibelle}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Gravite,
                                                                Converter={StaticResource GraviteEnCouleur}}" />
                                        <TextBlock Text="{Binding Titre}" FontSize="14"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Message}" FontSize="12.5" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TexteSecondaire}" />

                                    <TextBlock FontSize="11" Margin="0,6,0,0"
                                               Foreground="{StaticResource TexteSecondaire}">
                                        <Run Text="{Binding TypeLibelle}" /><Run Text=" · " /><Run
                                            Text="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource SuccesFond}" CornerRadius="8"
                    BorderBrush="{StaticResource Succes}" BorderThickness="1"
                    Padding="30" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Visibility="{Binding AucuneAlerte, Converter={StaticResource BooleenEnVisibilite}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource Succes}" />
                    <TextBlock Text="Rien ne demande votre attention pour l'instant."
                               FontSize="14" Margin="0,8,0,0"
                               Foreground="{StaticResource Succes}" />
                </StackPanel>
            </Border>
        </Grid>

    </DockPanel>
</UserControl>
