<Window x:Class="CeramiPro.App.Vues.FenetreFormulaire"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CeramiPro"
        Width="520"
        SizeToContent="Height"
        MinHeight="260"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Fond}"
        FontFamily="{StaticResource PoliceInterface}">

    <!--
        Fenêtre de saisie unique. Les champs sont construits à partir de ceux
        déclarés par la vue-modèle : ajouter un formulaire ne demande donc
        aucun XAML supplémentaire.

        La hauteur suit le contenu, sans dépasser celle d'un écran : un
        formulaire long défile plutôt que de sortir de l'écran.
    -->

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="{Binding Titre}"
                   Style="{StaticResource TitrePage}" Margin="0,0,0,16" />

        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding LibelleAnnuler}" IsCancel="True"
                        Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0" MinWidth="110" />
                <Button Content="{Binding LibelleEnregistrer}" Command="{Binding ValiderCommand}"
                        Style="{StaticResource BoutonPrincipal}" IsDefault="True" MinWidth="130"
                        IsEnabled="{Binding EnregistrementEnCours,
                                    Converter={StaticResource BooleenInverse}}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource DangerFond}" CornerRadius="6"
                Padding="12,9" Margin="0,12,0,0"
                Visibility="{Binding MessageErreur, Converter={StaticResource TexteEnVisibilite}}">
            <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                       Foreground="{StaticResource Danger}" FontSize="12.5" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ZoneChamps" />
        </ScrollViewer>

    </DockPanel>
</Window>
