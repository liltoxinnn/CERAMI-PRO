<UserControl x:Class="CeramiPro.App.Vues.EtiquettesVue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource PoliceInterface}">

    <!--
        Étiquettes des produits. La planche est mise en page dans un PDF au
        format A4 : c'est ce qui donne un résultat net à l'impression, quelle
        que soit l'imprimante.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="420" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Choix des produits -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">

            <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" Padding="16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Rechercher"
                                Command="{Binding ChercherCommand}"
                                Style="{StaticResource BoutonPrincipal}" Margin="8,0,0,0" />

                        <TextBox Style="{StaticResource Saisie}"
                                 Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ChercherCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Tout cocher" Command="{Binding ToutChoisirCommand}"
                                Style="{StaticResource BoutonSecondaire}" Margin="0,0,8,0" />
                        <Button Content="Tout décocher" Command="{Binding ToutDecocherCommand}"
                                Style="{StaticResource BoutonSecondaire}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Produits}" Style="{StaticResource TableauDonnees}"
                      IsReadOnly="False" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✔" Binding="{Binding Choisi}" Width="44" />
                    <DataGridTextColumn Header="Référence" Binding="{Binding Reference}"
                                        Width="Auto" IsReadOnly="True" />
                    <DataGridTextColumn Header="Nom" Binding="{Binding Nom}"
                                        Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}"
                                        Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Prix" Binding="{Binding Prix}"
                                        Width="Auto" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>

        <!-- Planche -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Carte}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Planche à imprimer" Style="{StaticResource TitreCarte}" />

                        <DockPanel Margin="0,4,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Produits cochés" FontSize="12.5"
                                       Foreground="{StaticResource TexteSecondaire}" />
                            <TextBlock Text="{Binding NombreChoisis}" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </DockPanel>

                        <TextBlock Text="Exemplaires par produit" Style="{StaticResource EtiquetteChamp}" />
                        <TextBox Style="{StaticResource Saisie}" HorizontalContentAlignment="Right"
                                 Text="{Binding Exemplaires, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Préparer la planche" Command="{Binding PreparerCommand}"
                                Style="{StaticResource BoutonPrincipal}" Margin="0,12,0,0" />

                        <Button Content="Imprimer en PDF" Command="{Binding ImprimerCommand}"
                                Style="{StaticResource BoutonSecondaire}" Margin="0,8,0,0"
                                IsEnabled="{Binding AucuneEtiquette,
                                            Converter={StaticResource BooleenInverse}}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource DangerFond}" CornerRadius="6" Padding="12,9"
                        Margin="0,0,0,12"
                        Visibility="{Binding MessageErreur, Converter={StaticResource TexteEnVisibilite}}">
                    <TextBlock Text="{Binding MessageErreur}" TextWrapping="Wrap"
                               Foreground="{StaticResource Danger}" FontSize="12.5" />
                </Border>

                <!-- Aperçu -->
                <Border Style="{StaticResource Carte}" Padding="16"
                        Visibility="{Binding AucuneEtiquette,
                                     Converter={StaticResource BooleenEnVisibiliteInverse}}">
                    <StackPanel>
                        <TextBlock Text="Aperçu" Style="{StaticResource TitreCarte}" />

                        <ItemsControl ItemsSource="{Binding Etiquettes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Bordure}" BorderThickness="1"
                                            CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nom}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PrixAffiche}" FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Terre}" />
                                            <TextBlock Text="{Binding CodeBarres}" FontSize="10.5"
                                                       Margin="0,3,0,0"
                                                       Foreground="{StaticResource TexteSecondaire}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
