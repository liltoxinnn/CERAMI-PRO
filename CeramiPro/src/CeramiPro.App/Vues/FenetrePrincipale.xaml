<Window x:Class="CeramiPro.App.Vues.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:CeramiPro.Presentation.Navigation;assembly=CeramiPro.Presentation"
        Title="CeramiPro — Gestion d'atelier de céramique"
        Height="800" Width="1280"
        MinHeight="620" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fond}"
        FontFamily="{StaticResource PoliceInterface}"
        FlowDirection="{Binding Sens, Converter={StaticResource SensEnFlowDirection}}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Menu latéral ===================== -->
        <Border Grid.Column="0" Background="{StaticResource Ardoise}" Width="262">
            <DockPanel>

                <!-- Marque -->
                <Border DockPanel.Dock="Top" Padding="20,22,20,18">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TexteInverse}"
                                   FontSize="19" FontWeight="Bold">
                            <Run Text="🏺" /><Run Text=" " /><Run Text="{Binding NomApplication, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SousTitreApplication}"
                                   Foreground="#8FA0B0" FontSize="11" Margin="0,3,0,0" />

                        <ItemsControl ItemsSource="{Binding Langues}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Converter={StaticResource LangueEnNom}}"
                                            Command="{Binding DataContext.ChoisirLangueCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#B9C4CF" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand"
                                            FontSize="11" Padding="8,3" Margin="0,0,4,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Utilisateur connecté -->
                <Border DockPanel.Dock="Bottom" Padding="20,14" Background="{StaticResource ArdoiseClaire}">
                    <StackPanel>
                        <TextBlock Text="{Binding NomUtilisateur}"
                                   Foreground="{StaticResource TexteInverse}"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NomRole}" Foreground="#8FA0B0" FontSize="11" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding LibelleChangerMotDePasse}"
                                    Command="{Binding ChangerMotDePasseCommand}"
                                    Foreground="#B9C4CF" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    FontSize="11" Padding="0,2" Margin="0,0,14,0" />

                            <Button Content="{Binding LibelleDeconnexion}"
                                    Command="{Binding DeconnecterCommand}"
                                    Foreground="#B9C4CF" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand"
                                    FontSize="11" Padding="0,2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Entrées -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Menu}" Margin="10,0,10,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type navigation:ElementNavigation}">
                                <StackPanel Margin="0,1">

                                    <!-- Entrée simple ou en-tête de groupe -->
                                    <Button Command="{Binding DataContext.NaviguerCommand,
                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand" BorderThickness="0" Padding="12,9">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Fond" Background="Transparent"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Fond" Property="Background"
                                                                Value="{StaticResource ArdoiseSurvol}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>

                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="⌄" FontSize="13"
                                                       Foreground="#8FA0B0" VerticalAlignment="Center"
                                                       Visibility="{Binding EstGroupe,
                                                                    Converter={StaticResource BooleenEnVisibilite}}" />
                                            <TextBlock Text="{Binding Icone}" FontSize="15" Width="26" />
                                            <TextBlock Text="{Binding Libelle}"
                                                       Foreground="{StaticResource TexteInverse}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>

                                    <!-- Sous-entrées -->
                                    <ItemsControl ItemsSource="{Binding Enfants}" Margin="26,0,0,4"
                                                  Visibility="{Binding EstDeplie,
                                                               Converter={StaticResource BooleenEnVisibilite}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type navigation:ElementNavigation}">
                                                <Button Command="{Binding DataContext.NaviguerCommand,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand" BorderThickness="0" Padding="10,6">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Fond" Background="Transparent"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Fond" Property="Background"
                                                                            Value="{StaticResource ArdoiseSurvol}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>

                                                    <TextBlock Text="{Binding Libelle}" Foreground="#B9C4CF"
                                                               FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ===================== Zone de travail ===================== -->
        <DockPanel Grid.Column="1">

            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1" Padding="28,18">
                <StackPanel>
                    <TextBlock Text="{Binding VueCourante.Titre}" Style="{StaticResource TitrePage}" />
                    <TextBlock Text="{Binding VueCourante.Introduction}"
                               Style="{StaticResource IntroductionPage}" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22">
                <ContentControl Content="{Binding VueCourante}" />
            </ScrollViewer>

        </DockPanel>
    </Grid>
</Window>
