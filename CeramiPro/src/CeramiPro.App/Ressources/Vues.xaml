<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:CeramiPro.Presentation.ViewModels;assembly=CeramiPro.Presentation"
                    xmlns:ecrans="clr-namespace:CeramiPro.Presentation.ViewModels.Ecrans;assembly=CeramiPro.Presentation"
                    xmlns:vues="clr-namespace:CeramiPro.App.Vues">

    <!--
        Association entre chaque vue-modèle et son écran. Les seize écrans de
        liste partagent la même vue générique : leurs colonnes viennent de la
        vue-modèle, pas du XAML.
    -->

    <DataTemplate DataType="{x:Type vm:TableauDeBordVueModele}">
        <vues:TableauDeBordVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:MatieresVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ProduitsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:FournisseursVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:AchatsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:MouvementsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ClientsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CommandesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:VentesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:FacturesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:PaiementsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:DepensesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ProductionVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CuissonsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:DecorationsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:QualiteVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:UtilisateursVueModele}">
        <vues:VueListe />
    </DataTemplate>
</ResourceDictionary>
