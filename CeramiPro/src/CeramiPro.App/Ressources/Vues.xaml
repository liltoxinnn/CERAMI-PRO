<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:CeramiPro.Presentation.ViewModels;assembly=CeramiPro.Presentation"
                    xmlns:ecrans="clr-namespace:CeramiPro.Presentation.ViewModels.Ecrans;assembly=CeramiPro.Presentation"
                    xmlns:vues="clr-namespace:CeramiPro.App.Vues">

    <!--
        Association entre chaque vue-modèle et son écran.

        Les écrans de liste partagent la même vue générique, et les trois
        écrans de saisie ligne par ligne — caisse, achat, enfournement — la
        même vue de document : leurs colonnes et leurs champs viennent de la
        vue-modèle, pas du XAML.
    -->

    <DataTemplate DataType="{x:Type vm:TableauDeBordVueModele}">
        <vues:TableauDeBordVue />
    </DataTemplate>

    <!-- Écrans de liste -->
    <DataTemplate DataType="{x:Type ecrans:MatieresVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ProduitsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ProduitsStockVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:FournisseursVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:AchatsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:MouvementsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ClientsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CommandesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:VentesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:FacturesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:PaiementsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:DepensesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ProductionVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ProductionEnCoursVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:HistoriqueProductionVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CuissonsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:DecorationsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:QualiteVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:UtilisateursVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:FoursVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:UnitesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:RecettesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CategoriesMatieresVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CategoriesProduitsVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CategoriesDepensesVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:TypesDecorationVueModele}">
        <vues:VueListe />
    </DataTemplate>

    <!-- Saisie ligne par ligne -->
    <DataTemplate DataType="{x:Type ecrans:CaisseVueModele}">
        <vues:VueDocument />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:NouvelAchatVueModele}">
        <vues:VueDocument />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:EnfournementVueModele}">
        <vues:VueDocument />
    </DataTemplate>

    <!-- Écrans particuliers -->
    <DataTemplate DataType="{x:Type ecrans:RapportsVueModele}">
        <vues:RapportsVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:AlertesVueModele}">
        <vues:AlertesVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:StockVueModele}">
        <vues:StockVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:ParametresVueModele}">
        <vues:ParametresVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:SauvegardeVueModele}">
        <vues:SauvegardeVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:EtiquettesVueModele}">
        <vues:EtiquettesVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:TableauProductionVueModele}">
        <vues:TableauProductionVue />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ecrans:CalculateursVueModele}">
        <vues:CalculateursVue />
    </DataTemplate>

</ResourceDictionary>
